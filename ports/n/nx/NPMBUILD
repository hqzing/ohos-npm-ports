#!/usr/bin/env node
import assert from 'node:assert/strict';
import { constants, accessSync, chmodSync, cpSync, mkdirSync, readdirSync, readFileSync, renameSync, rmSync, statSync } from 'node:fs';
import { createRequire } from 'node:module';
import { dirname, join, relative, sep } from 'node:path';
import { Port, resource, run, fetchSource, fetchResource, writeJson, requirePackage, recipeContext } from '../../../cli/recipe.mjs';

const version = '24.0.3';
const vt100Rev = 'b15dc3b0f7db94167a9c584f1d403899c0cc871d';
const weztermRev = 'b538ee29e1e89eeb4832fb35ae095564dce34c29';
const rootDir = import.meta.dirname;
const sourceDir = join(rootDir, 'src');
const packageDir = join(rootDir, `nx-${version}`);
const jsbuildDir = join(rootDir, '_jsbuild');
const carryDir = join(rootDir, 'carry');
const npmInstallPackages = [
  '../nx.tgz',
  'typescript@6.0.3',
  '@types/node@24.13.3',
  '@angular-devkit/core@22.1.4',
  '@angular-devkit/architect@0.2201.4',
  '@angular-devkit/schematics@22.1.4',
  'rxjs@7.8.2',
  'prettier@3.6.2',
  'ts-node@10.9.1',
  '@pnpm/lockfile-types@6.0.0',
  '@nx/key@5.0.4',
  '@nx/powerpack-license@5.0.4',
  '@swc-node/register@1.11.1',
  '@swc/core@1.15.10',
  'ora@5.4.1',
  'chalk@4.1.2',
  'cli-cursor@3.1.0',
  'cli-spinners@2.6.1',
  'log-symbols@4.1.0',
  'string-width@4.2.3',
  'strip-ansi@6.0.1',
  'ansi-regex@5.0.1',
  'is-interactive@1.0.0',
  'is-unicode-supported@0.1.0',
  'onetime@5.1.2',
  'restore-cursor@3.1.0',
  'signal-exit@3.0.7',
];

function listFiles(root, dir = root) {
  const files = [];
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    const file = join(dir, entry.name);
    if (entry.isDirectory()) files.push(...listFiles(root, file));
    else if (entry.isFile()) files.push(relative(root, file).split(sep).join('/'));
  }
  return files.sort();
}

function copyMatching(source, destination, extension) {
  mkdirSync(destination, { recursive: true });
  for (const entry of readdirSync(source, { withFileTypes: true })) {
    if (entry.isFile() && entry.name.endsWith(extension)) {
      cpSync(join(source, entry.name), join(destination, entry.name));
    }
  }
}

function copyMigrationDocs(jsSourceDir) {
  const source = join(jsSourceDir, 'src/migrations');
  for (const file of listFiles(source)) {
    if (!file.endsWith('.md')) continue;
    const destination = join(packageDir, 'dist/src/migrations', file);
    mkdirSync(dirname(destination), { recursive: true });
    cpSync(join(source, file), destination);
  }
}

export default class Nx extends Port {
  static pkgname = 'nx';
  static upstream = 'nx';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [`nx-${version}`];
  static source = `https://registry.npmjs.org/nx/-/nx-${version}.tgz`;
  static sha256 = '7b28f6421f8547ebf1437655e903e25ac781e961e7068e40c3d0f6dcb76a0e1f';
  static resources = [
    resource(
      'vt100',
      `https://codeload.github.com/JamesHenry/vt100-rust/tar.gz/${vt100Rev}`,
      '644bb51e1072711e8e44da70dbfa69e0bcfd1579a289ea3b9758e4ca26113fc1',
    ),
    resource(
      'wezterm',
      `https://codeload.github.com/cammisuli/wezterm/tar.gz/${weztermRev}`,
      'd722cb3cd4eea2d5309c6a39a09768cc57099f42aef21f5e527e28eafbd9b542',
    ),
  ];

  build() {
    // Build the native binding with cargo and the CLI JavaScript with plain tsc.
    // Upstream's full monorepo build requires toolchains unavailable on OpenHarmony.
    run('git', [
      'clone', '--depth', '1', '--filter=blob:none', '--sparse', '--branch', version,
      'https://github.com/nrwl/nx', sourceDir,
    ], { cwd: rootDir });
    run('git', ['sparse-checkout', 'set', 'packages/nx'], { cwd: sourceDir });

    const gitdepsDir = join(rootDir, 'gitdeps');
    mkdirSync(join(gitdepsDir, 'wezterm'), { recursive: true });

    fetchResource('vt100', join(rootDir, 'vt100.tar.gz'));
    run('tar', ['-zxf', 'vt100.tar.gz'], { cwd: rootDir });
    renameSync(join(rootDir, `vt100-rust-${vt100Rev}`), join(gitdepsDir, 'vt100-rust'));
    rmSync(join(rootDir, 'vt100.tar.gz'));

    fetchResource('wezterm', join(rootDir, 'wezterm.tar.gz'));
    run('tar', [
      '-zxf', 'wezterm.tar.gz', `wezterm-${weztermRev}/pty`, `wezterm-${weztermRev}/filedescriptor`,
    ], { cwd: rootDir });
    renameSync(join(rootDir, `wezterm-${weztermRev}/pty`), join(gitdepsDir, 'wezterm/pty'));
    renameSync(join(rootDir, `wezterm-${weztermRev}/filedescriptor`), join(gitdepsDir, 'wezterm/filedescriptor'));
    rmSync(join(rootDir, `wezterm-${weztermRev}`), { recursive: true, force: true });
    rmSync(join(rootDir, 'wezterm.tar.gz'));

    run('patch', ['-p1'], {
      cwd: join(gitdepsDir, 'wezterm'),
      input: readFileSync(join(rootDir, 'patches/0002-portable-pty-nix-bump.patch')),
    });
    for (const patch of [
      '0001-nx-source-ohos.patch',
      '0003-assert-supported-platform.patch',
      '0004-tsc-expect-error-compat.patch',
    ]) {
      run('patch', ['-p1'], { cwd: sourceDir, input: readFileSync(join(rootDir, 'patches', patch)) });
    }

    run('cargo', ['build', '--release'], { cwd: sourceDir });
    const nativeBuild = join(sourceDir, 'target/release/libnx.so');
    assert.ok(statSync(nativeBuild).isFile());
    const nativeOutput = join(sourceDir, 'nx.openharmony-arm64.node');
    cpSync(nativeBuild, nativeOutput);
    run('llvm-strip', ['--strip-all', nativeOutput]);
    chmodSync(nativeOutput, 0o755);

    fetchSource(join(rootDir, 'nx.tgz'));
    run('tar', ['-zxf', 'nx.tgz'], { cwd: rootDir });
    renameSync(join(rootDir, 'package'), packageDir);
    const publishedDist = listFiles(join(packageDir, 'dist')).map((file) => `dist/${file}`);

    mkdirSync(jsbuildDir, { recursive: true });
    writeJson(join(jsbuildDir, 'package.json'), { name: 'nx-jsbuild', private: true });
    cpSync(join(sourceDir, 'tsconfig.base.json'), join(jsbuildDir, 'tsconfig.base.json'));
    mkdirSync(join(jsbuildDir, 'packages'), { recursive: true });
    cpSync(join(sourceDir, 'packages/nx'), join(jsbuildDir, 'packages/nx'), { recursive: true });
    rmSync(join(jsbuildDir, 'packages/nx/dist'), { recursive: true, force: true });

    run('npm', ['install', '--ignore-scripts', ...npmInstallPackages], { cwd: jsbuildDir });
    run(process.execPath, [
      join(jsbuildDir, 'node_modules/typescript/bin/tsc'), '-p', 'packages/nx/tsconfig.lib.json',
    ], { cwd: jsbuildDir });

    mkdirSync(carryDir, { recursive: true });
    cpSync(join(packageDir, 'dist/src/core/graph'), join(carryDir, 'graph'), { recursive: true });
    copyMatching(join(packageDir, 'dist/src/native'), carryDir, '.wasm');
    rmSync(join(packageDir, 'dist'), { recursive: true, force: true });
    cpSync(join(jsbuildDir, 'packages/nx/dist'), join(packageDir, 'dist'), { recursive: true });
    rmSync(join(packageDir, 'dist/tsconfig.tsbuildinfo'), { force: true });
    chmodSync(join(packageDir, 'dist/bin/nx.js'), 0o755);
    chmodSync(join(packageDir, 'dist/bin/nx-cloud.js'), 0o755);

    const jsSourceDir = join(jsbuildDir, 'packages/nx');
    copyMatching(join(jsSourceDir, 'presets'), join(packageDir, 'dist/presets'), '.json');
    copyMigrationDocs(jsSourceDir);
    for (const file of [
      'src/command-line/migrate/run-migration-process.js',
      'src/ai/set-up-ai-agents/schema.d.ts',
      'src/utils/perf-hooks.d.ts',
      'src/utils/yarn-syml/syml-grammar.js',
    ]) {
      cpSync(join(jsSourceDir, file), join(packageDir, 'dist', file));
    }
    mkdirSync(join(packageDir, 'dist/src/command-line/completion'), { recursive: true });
    cpSync(
      join(jsSourceDir, 'src/command-line/completion/scripts'),
      join(packageDir, 'dist/src/command-line/completion/scripts'),
      { recursive: true },
    );
    for (const file of [
      'browser.js',
      'index.js',
      'index.d.ts',
      'native-bindings.js',
      'nx.wasi-browser.js',
      'nx.wasi.cjs',
      'wasi-worker-browser.mjs',
      'wasi-worker.mjs',
    ]) {
      cpSync(join(jsSourceDir, 'src/native', file), join(packageDir, 'dist/src/native', file));
    }

    mkdirSync(join(packageDir, 'dist/src/core'), { recursive: true });
    cpSync(join(carryDir, 'graph'), join(packageDir, 'dist/src/core/graph'), { recursive: true });
    copyMatching(carryDir, join(packageDir, 'dist/src/native'), '.wasm');
    cpSync(nativeOutput, join(packageDir, 'dist/src/native/nx.openharmony-arm64.node'));

    const platformAssert = join(packageDir, 'dist/src/native/assert-supported-platform.js');
    run(process.execPath, ['--check', platformAssert]);
    assert.ok(readFileSync(platformAssert, 'utf8').includes('openharmony'));
    accessSync(join(packageDir, 'dist/bin/nx.js'), constants.X_OK);
    accessSync(join(packageDir, 'dist/bin/nx-cloud.js'), constants.X_OK);

    const ourDist = listFiles(join(packageDir, 'dist'))
      .map((file) => `dist/${file}`)
      .filter((file) => file !== 'dist/src/native/nx.openharmony-arm64.node');
    assert.deepEqual(ourDist, publishedDist, 'dist parity check FAILED: compiled dist does not match published file set');
  }

  package() {
    const packed = run('npm', ['pack', '--ignore-scripts', '--silent', packageDir], {
      cwd: rootDir,
      capture: true,
    }).stdout.trim().split('\n').at(-1);
    const contents = run('tar', ['-tzf', packed], { cwd: rootDir, capture: true }).stdout;
    assert.ok(contents.includes('dist/src/native/nx.openharmony-arm64.node'), 'native binding missing from npm tarball');

    const outputRequire = createRequire(join(packageDir, 'package.json'));
    const binding = outputRequire('./dist/src/native/native-bindings.js');
    assert.equal(binding.IS_WASM, false, 'expected native binding, got WASI fallback');
    const exports = Object.keys(binding).length;
    console.log(`native binding loaded, IS_WASM=false, ${exports} exports`);
    assert.ok(exports >= 50, `suspiciously few exports: ${exports}`);
  }

  async test() {
    const [{ mkdtempSync }, { tmpdir }] = await Promise.all([import('node:fs'), import('node:os')]);
    const { projectDir } = recipeContext();
    const pkg = requirePackage('nx/package.json');
    const packageRoot = dirname(recipeContext().resolvePackage('nx/package.json'));
    const bin = typeof pkg.bin === 'string' ? pkg.bin : pkg.bin.nx;
    const nx = join(packageRoot, bin);
    const smokeDir = join(projectDir, 'smoke');
    const socketDir = mkdtempSync(join(tmpdir(), 'nx-'));
    mkdirSync(join(smokeDir, 'packages/pkg-a'), { recursive: true });
    writeJson(join(smokeDir, 'package.json'), {
      name: 'nx-ohos-smoke',
      private: true,
      workspaces: ['packages/*'],
    });
    writeJson(join(smokeDir, 'nx.json'), {});
    writeJson(join(smokeDir, 'packages/pkg-a/package.json'), {
      name: 'pkg-a',
      version: '1.0.0',
      scripts: { build: 'echo PKG_A_BUILT' },
    });
    run('git', ['init', '-q', '.'], { cwd: smokeDir });
    mkdirSync(socketDir, { recursive: true });
    const options = { cwd: smokeDir, capture: true, env: { NX_SOCKET_DIR: socketDir } };

    const runResult = run(process.execPath, [nx, 'run', 'pkg-a:build'], options);
    const runOutput = `${runResult.stdout}${runResult.stderr}`;
    process.stdout.write(runOutput);
    assert.ok(runOutput.includes('PKG_A_BUILT'));

    const showResult = run(process.execPath, [nx, 'show', 'projects'], options);
    const showOutput = `${showResult.stdout}${showResult.stderr}`;
    process.stdout.write(showOutput);
    assert.ok(showOutput.includes('pkg-a'));

    const graphFile = join(smokeDir, 'graph.json');
    run(process.execPath, [nx, 'graph', `--file=${graphFile}`], {
      cwd: smokeDir,
      env: { NX_SOCKET_DIR: socketDir },
    });
    assert.ok(statSync(graphFile).size > 0);
    run(process.execPath, [nx, 'reset'], { cwd: smokeDir, env: { NX_SOCKET_DIR: socketDir } });

    return {
      result: { run: true, showProjects: true, graph: true, reset: true },
      assets: [],
    };
  }
}
