#!/usr/bin/env node
import assert from 'node:assert/strict';
import { Port, resource, run, cd, fetchSource, fetchResource, writeJson } from '../../../cli/recipe.mjs';
import { chmodSync, cpSync, mkdirSync, readFileSync, renameSync, rmSync, statSync } from 'node:fs';
import { join } from 'node:path';

const version = '16.4.3';
const rootDir = import.meta.dirname;
const sourceDir = join(rootDir, 'src');
const packageDir = join(rootDir, `next-${version}`);
const slotPackageDir = join(rootDir, 'next-swc-openharmony-arm64');

export default class Next extends Port {
  static pkgname = 'next';
  static upstream = 'next';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [
    '@ohos-npm-ports/next-swc-openharmony-arm64:next-swc-openharmony-arm64',
    `next-${version}`,
  ];
  static source = `https://registry.npmjs.org/next/-/next-${version}.tgz`;
  static sha256 = 'd37409b7530c4873cd14c0619a7b8734777fd0dc2cae627bb592e5a82f74f8f4';
  static resources = [
    resource(
      'upstream',
      `https://codeload.github.com/vercel/next.js/tar.gz/refs/tags/v${version}`,
      '403b3475f119fd0894c3ed57c6b434edb00cf4675a5d3aeeb983521e9f948ccd',
    ),
  ];

  prepare() {
    run('sh', ['-c', 'command -v curl']);
    run('sh', ['-c', 'command -v cargo']);
    rmSync(sourceDir, { recursive: true, force: true });
    rmSync(packageDir, { recursive: true, force: true });
    rmSync(slotPackageDir, { recursive: true, force: true });
    mkdirSync(sourceDir, { recursive: true });
    mkdirSync(slotPackageDir, { recursive: true });

    const sourceArchive = join(rootDir, 'next-source.tar.gz');
    fetchResource('upstream', sourceArchive);
    run('tar', ['-zxf', sourceArchive, '-C', sourceDir, '--strip-components=1']);
    rmSync(sourceArchive, { force: true });
    rmSync(join(sourceDir, 'rust-toolchain.toml'), { force: true });

    const packageArchive = join(rootDir, 'next.tgz');
    fetchSource(packageArchive);
    run('tar', ['-zxf', packageArchive, '-C', rootDir]);
    renameSync(join(rootDir, 'package'), packageDir);
    rmSync(packageArchive, { force: true });
  }

  build() {
    const host = run('rustc', ['-vV'], { capture: true }).stdout.match(/^host: (.+)$/m)?.[1];
    assert.equal(host, 'aarch64-unknown-linux-ohos');

    cd(sourceDir);
    run('git', ['init']);
    run('git', [
      '-c', 'user.name=npm-ports',
      '-c', 'user.email=npm-ports@localhost',
      'commit', '--allow-empty', '-m', `Next.js ${version} source`,
    ]);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0003-turbo-tasks-fs-ohos.patch')) });
    assert.ok(readFileSync('turbopack/crates/turbo-tasks-fs/src/disk.rs', 'utf8').includes('into_os_string'));
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0004-openharmony-project-path.patch')) });
    assert.ok(readFileSync('crates/next-napi-bindings/src/next_api/project.rs', 'utf8').includes('into_os_string'));
    process.env.RUSTC_BOOTSTRAP = '1';
    run('cargo', [
      'build', '-p', 'next-napi-bindings', '--release',
      '--features', 'image-extended,tracing/release_max_level_trace',
    ]);
    const nativeSource = 'target/release/libnext_napi_bindings.so';
    assert.ok(statSync(nativeSource).isFile());
    cpSync(nativeSource, join(slotPackageDir, 'next-swc.openharmony-arm64.node'));
    cd(rootDir);
  }

  package() {
    cd(rootDir);
    const native = join(slotPackageDir, 'next-swc.openharmony-arm64.node');
    run('llvm-strip', ['--strip-all', native]);
    chmodSync(native, statSync(native).mode | 0o111);

    cd(packageDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0001-openharmony-loader.patch')) });
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0002-package-json.patch')) });
    cd(rootDir);

    writeJson(join(slotPackageDir, 'package.json'), {
      version,
      description: 'OpenHarmony arm64 native SWC binding for Next.js',
      os: ['openharmony'],
      cpu: ['arm64'],
      main: 'next-swc.openharmony-arm64.node',
      files: ['next-swc.openharmony-arm64.node'],
      license: 'MIT',
      engines: { node: '>= 20' },
    });

    const loader = readFileSync(join(packageDir, 'dist/build/swc/index.js'), 'utf8');
    assert.ok(loader.includes('openharmony-arm64'));
    assert.ok(loader.includes('@ohos-npm-ports/next-swc-openharmony-arm64'));
  }
}
