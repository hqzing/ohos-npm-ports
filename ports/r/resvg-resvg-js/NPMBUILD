#!/usr/bin/env node
import assert from 'node:assert/strict';
import { chmodSync, cpSync, existsSync, readFileSync, rmSync } from 'node:fs';
import { join } from 'node:path';
import { Port, resource, run, cd, fetchSource, fetchResource, readJson, requirePackage } from '../../../cli/recipe.mjs';

const version = '2.6.2';
const rootDir = import.meta.dirname;
const sourceDir = join(rootDir, `resvg-js-${version}`);

export default class ResvgResvgJs extends Port {
  static pkgname = 'resvg-resvg-js';
  static upstream = '@resvg/resvg-js';
  static version = version;
  static revision = 4;
  static distTag = 'latest';
  static packages = [`resvg-js-${version}`];
  static source = `https://github.com/thx/resvg-js/archive/refs/tags/v${version}.tar.gz`;
  static sha256 = 'a21eb27baac8e32b34ce950166382b487aac4877f0979495ac8eca27776a56af';
  static resources = [
    resource(
      'npm_manifest',
      `https://registry.npmjs.org/@resvg/resvg-js/-/resvg-js-${version}.tgz`,
      '5b4c67c32d593a42bca6d97320b57465cf340bee441f4cb6bf250b1086872a43',
    ),
  ];

  build() {
    // Build the cdylib directly: the container's rustc host is already OHOS, and
    // upstream's pinned napi CLI neither recognizes openharmony nor needs to
    // regenerate the committed JS binding.
    const archive = join(rootDir, 'resvg-js.tar.gz');
    fetchSource(archive);
    run('tar', ['-zxf', archive, '-C', rootDir]);
    rmSync(archive);

    const npmArchive = join(rootDir, 'resvg-js-npm.tgz');
    fetchResource('npm_manifest', npmArchive);
    run('tar', ['-xzf', npmArchive, '-C', sourceDir, '--strip-components=1', 'package/package.json']);
    rmSync(npmArchive);

    cd(sourceDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0001-update-package-json.patch')) });
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0002-openharmony-loader.patch')) });

    // The committed nightly predates OHOS target support and would trigger an
    // unwanted rustup lookup instead of using Harmonybrew's native Rust.
    rmSync('rust-toolchain', { force: true });
    run('cargo', ['build', '--release']);

    const library = 'target/release/libresvg_js.so';
    const addon = 'resvgjs.linux-arm64-ohos.node';
    assert.ok(existsSync(library), 'target/release/libresvg_js.so is missing');
    cpSync(library, addon);
    run('llvm-strip', ['--strip-all', addon]);
    chmodSync(addon, 0o755);

    run(process.execPath, ['--check', 'js-binding.js']);
    assert.ok(readFileSync('js-binding.js', 'utf8').includes("case 'openharmony':"));
    const pkg = readJson('package.json');
    assert.equal(pkg.optionalDependencies['@resvg/resvg-js-linux-arm64-gnu'], version);
    assert.equal(pkg.optionalDependencies['@resvg/resvg-js-darwin-arm64'], version);
    assert.equal(pkg.optionalDependencies['@resvg/resvg-js-win32-x64-msvc'], version);
    for (const [name, range] of Object.entries(pkg.optionalDependencies ?? {})) {
      if (name.startsWith('@resvg/resvg-js-')) {
        assert.equal(range, pkg.version, `optionalDependencies["${name}"] drifted from the upstream version`);
      }
    }
  }

  test() {
    const { Resvg } = requirePackage('@resvg/resvg-js');
    const svg = `<svg width="100" height="50" xmlns="http://www.w3.org/2000/svg">
  <rect x="10" y="10" width="30" height="20" fill="red"/>
</svg>`;
    const resvg = new Resvg(svg);
    const bbox = resvg.innerBBox();
    assert.ok(bbox && typeof bbox.width === 'number' && bbox.width > 0 && bbox.height > 0, 'unexpected bbox result');
    assert.deepEqual(
      { x: bbox.x, y: bbox.y, width: bbox.width, height: bbox.height },
      { x: 10, y: 10, width: 30, height: 20 },
    );

    const rendered = resvg.render();
    const png = rendered.asPng();
    const magic = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a];
    for (let index = 0; index < magic.length; index++) assert.equal(png[index], magic[index], 'output is not a valid PNG');
    return {
      result: {
        bbox: { x: bbox.x, y: bbox.y, width: bbox.width, height: bbox.height },
        png: true,
        width: rendered.width,
        height: rendered.height,
      },
      assets: [],
    };
  }
}
