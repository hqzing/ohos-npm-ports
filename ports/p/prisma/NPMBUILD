#!/usr/bin/env node
/*
@ohos-npm-ports/prisma 8.0.0-rc.29

Download the official prisma tarball, patch its manifest, and repack without
compiling. Prisma 8 is a pure-JavaScript shell around @prisma/cli-engine,
@prisma/orm-toolchain and @prisma/composer-cli; it no longer ships the Rust
engine resolver from prisma 5 or downloads engines from binaries.prisma.sh.

The Composer packages pin alchemy 2.0.0-beta.83, which pulls @libsql/client and
libsql. libsql has no OpenHarmony npm target, so repack both Composer packages
against alchemy 2.0.0-beta.84 (same API, no libsql dependency) and alias them
from the main package. Consumer tests cover contract emit/print with Node and,
when available, bun.
*/
import assert from 'node:assert/strict';
import { dirname, join } from 'node:path';
import { Port, resource, run, cd, fetchSource, fetchResource, readJson, writeJson, requirePackage, recipeContext } from '../../../cli/recipe.mjs';
import { cpSync, mkdirSync, readdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs';

const version = '8.0.0-rc.29';
const composerVersion = '0.35.0';
const ormVersion = '8.0.0-rc.21';
const rootDir = import.meta.dirname;
const buildDir = join(rootDir, 'build');
const sourceDir = join(buildDir, 'src');
const composerSourceDir = join(buildDir, 'composer-src');
const composerCliSourceDir = join(buildDir, 'composer-cli-src');

function filesBelow(directory) {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const file = join(directory, entry.name);
    return entry.isDirectory() ? filesBelow(file) : entry.isFile() ? [file] : [];
  });
}

function repackComposer(directory, expectedName, cli = false) {
  const file = join(directory, 'package.json');
  const pkg = readJson(file);
  assert.equal(pkg.name, expectedName);
  assert.equal(pkg.version, composerVersion);
  pkg.version = version;
  if (cli) pkg.dependencies['@prisma/composer'] = `npm:@ohos-npm-ports/prisma-composer@${version}`;
  pkg.dependencies.alchemy = '2.0.0-beta.84';
  delete pkg.devDependencies;
  writeJson(file, pkg);
}

function commandAvailable(command) {
  try {
    run(command, ['--version'], { capture: true });
    return true;
  } catch (error) {
    if (error.code === 'ENOENT') return false;
    throw error;
  }
}

export default class Prisma extends Port {
  static pkgname = 'prisma';
  static upstream = 'prisma';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [
    '@ohos-npm-ports/prisma-composer:build/composer',
    '@ohos-npm-ports/prisma-composer-cli:build/composer-cli',
    'build/pkg',
  ];
  static source = `https://registry.npmjs.org/prisma/-/prisma-${version}.tgz`;
  static sha256 = '82571b05c3a41080e11bf9910d9faedb7eeb0eb14550f3669e9cffdd98f2e1c4';
  static resources = [
    resource(
      'composer',
      `https://registry.npmjs.org/@prisma/composer/-/composer-${composerVersion}.tgz`,
      'dcd6e69c550056f756e9895fc7eb4e749d6d2a69d18eae9f8b661509dcaf8ed1',
    ),
    resource(
      'composer_cli',
      `https://registry.npmjs.org/@prisma/composer-cli/-/composer-cli-${composerVersion}.tgz`,
      'c7222b534e91d02af1711f7d5d3715353ce82ad2d1d2cc1ac1f9870f1626d33d',
    ),
  ];

  prepare() {
    console.log(`=== fetch: 官方 prisma@${version} + Composer ${composerVersion} ===`);
    rmSync(buildDir, { recursive: true, force: true });
    mkdirSync(buildDir, { recursive: true });
    cd(buildDir);
    fetchSource('src.tgz');
    fetchResource('composer', 'composer.tgz');
    fetchResource('composer_cli', 'composer-cli.tgz');
    run('tar', ['-zxf', 'src.tgz']);
    rmSync('src.tgz');
    renameSync('package', 'src');
    mkdirSync('composer-src');
    mkdirSync('composer-cli-src');
    run('tar', ['-zxf', 'composer.tgz', '-C', 'composer-src', '--strip-components=1']);
    run('tar', ['-zxf', 'composer-cli.tgz', '-C', 'composer-cli-src', '--strip-components=1']);
    rmSync('composer.tgz');
    rmSync('composer-cli.tgz');
  }

  build() {
    console.log('=== build: 打 manifest patch + grep marker + 入口回归 ===');
    cd(sourceDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0002-update-package-json.patch')) });
    const sourcePkg = readJson(join(sourceDir, 'package.json'));
    assert.equal(sourcePkg.version, version);
    assert.equal(sourcePkg.dependencies['@prisma/composer-cli'], `npm:@ohos-npm-ports/prisma-composer-cli@${version}`);

    for (const file of filesBelow(join(sourceDir, 'dist'))) {
      assert.ok(!/binaries\.prisma\.sh|getBinaryPathsByVersion/.test(readFileSync(file, 'utf8')),
        `prisma ${version} reintroduced an engine download path in ${file}`);
    }
    assert.equal(sourcePkg.type, 'module');
    assert.equal(sourcePkg.bin?.prisma, './dist/prisma.js');
    run(process.execPath, ['--check', join(sourceDir, 'dist/prisma.js')]);
    run(process.execPath, ['--check', join(sourceDir, 'dist/config.js')]);

    repackComposer(composerSourceDir, '@prisma/composer');
    repackComposer(composerCliSourceDir, '@prisma/composer-cli', true);
    assert.ok(statSync(join(composerSourceDir, 'dist/index.mjs')).isFile());
    assert.ok(statSync(join(composerCliSourceDir, 'dist/family.mjs')).isFile());
    run(process.execPath, ['--check', join(composerSourceDir, 'dist/index.mjs')]);
    run(process.execPath, ['--check', join(composerCliSourceDir, 'dist/family.mjs')]);
  }

  package() {
    console.log('=== package: 组装发布目录 + manifest 断言 ===');
    for (const directory of ['pkg', 'composer', 'composer-cli']) {
      rmSync(join(buildDir, directory), { recursive: true, force: true });
    }
    cpSync(sourceDir, join(buildDir, 'pkg'), { recursive: true, verbatimSymlinks: true });
    cpSync(composerSourceDir, join(buildDir, 'composer'), { recursive: true, verbatimSymlinks: true });
    cpSync(composerCliSourceDir, join(buildDir, 'composer-cli'), { recursive: true, verbatimSymlinks: true });
    for (const directory of ['pkg', 'composer', 'composer-cli']) {
      rmSync(join(buildDir, directory, 'node_modules'), { recursive: true, force: true });
      assert.equal(readJson(join(buildDir, directory, 'package.json')).version, version);
    }
  }

  static testTimeout = 1_800_000;

  testSetup() {
    const context = recipeContext();
    const projectFile = join(context.projectDir, 'package.json');
    const project = readJson(projectFile);
    project.dependencies ??= {};
    project.dependencies['@prisma/orm-postgres'] = ormVersion;
    writeJson(projectFile, project);
    const app = join(context.projectDir, 'app');
    mkdirSync(app, { recursive: true });
    writeFileSync(join(app, 'prisma.config.ts'), `import { definePrismaConfig } from 'prisma/config';
import { defineConfig as ormConfig } from '@prisma/orm-postgres/config';

export default definePrismaConfig({
  orm: ormConfig({
    contract: './contract.prisma',
  }),
});
`);
    writeFileSync(join(app, 'contract.prisma'), `// use prisma-8
model Widget {
  id   Int    @id @default(autoincrement())
  name String
}
`);
  }

  test() {
    const context = recipeContext();
    const app = join(context.projectDir, 'app');
    const pkg = requirePackage('prisma/package.json');
    const expectedVersion = context.mode === 'overrides' ? context.portVersion : version;
    assert.equal(pkg.version, expectedVersion);
    assert.equal(pkg.name, context.mode === 'overrides' ? '@ohos-npm-ports/prisma' : 'prisma');
    const cli = join(dirname(context.resolvePackage('prisma/package.json')), pkg.bin.prisma);
    const env = {
      DO_NOT_TRACK: '1',
      PRISMA_DISABLE_TELEMETRY: '1',
      PRISMA_CLI_UPDATE_CHECK_DIR: join(context.projectDir, 'update-check'),
    };

    const versionResult = run(process.execPath, [cli, '--version'], { cwd: app, env, capture: true });
    const versionOutput = `${versionResult.stdout}${versionResult.stderr}`;
    assert.ok(versionOutput.split('\n').map((line) => line.trim()).includes(expectedVersion), versionOutput);

    const emit = run(process.execPath, [cli, 'contract', 'emit'], { cwd: app, env, capture: true });
    assert.ok(`${emit.stdout}${emit.stderr}`.includes('Emitted contract.json and contract.d.ts'));
    assert.ok(statSync(join(app, 'contract.json')).size > 0);
    assert.ok(statSync(join(app, 'contract.d.ts')).size > 0);
    assert.ok(readFileSync(join(app, 'contract.d.ts'), 'utf8').includes('public_Widget'));
    const contract = readJson(join(app, 'contract.json'));
    assert.ok(contract.roots?.Widget, 'emitted contract is missing the Widget root');

    const print = run(process.execPath, [cli, 'contract', 'print', '--format', 'human'], { cwd: app, env, capture: true });
    assert.ok(print.stdout.includes('namespace public'), `${print.stdout}${print.stderr}`);
    assert.ok(print.stdout.includes('model Widget'), `${print.stdout}${print.stderr}`);

    const bun = commandAvailable('bun');
    if (bun) {
      rmSync(join(app, 'contract.json'), { force: true });
      rmSync(join(app, 'contract.d.ts'), { force: true });
      const bunEmit = run('bun', [cli, 'contract', 'emit'], { cwd: app, env, capture: true });
      assert.ok(`${bunEmit.stdout}${bunEmit.stderr}`.includes('Emitted contract.json and contract.d.ts'));
      assert.ok(statSync(join(app, 'contract.json')).size > 0);
      assert.ok(statSync(join(app, 'contract.d.ts')).size > 0);
    }
    return {
      result: { cliVersion: version, contractEmit: true, contractPrint: true, bunEmit: bun },
      assets: [],
    };
  }
}
