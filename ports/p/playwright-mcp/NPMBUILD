#!/usr/bin/env node
/*
# Playwright MCP

Repackages upstream `@playwright/mcp` as `@ohos-npm-ports/playwright-mcp`.
The `playwright-core` dependency resolves to the matching OpenHarmony core
port. The launcher imports only core; the unused `playwright` dependency is
omitted. Other upstream package files are verified byte-for-byte unchanged.

On OpenHarmony, use an installed TCP CDP browser (default: Haitai), or pass
`--cdp-endpoint` to attach to an existing endpoint. This package does not
provide Chromium, Firefox or WebKit binaries for OpenHarmony. Desktop launch
behavior remains that of upstream core.

`PLAYWRIGHT_CORE_TARBALL=/absolute/path/to/core.tgz npm-ports test ports/p/playwright-mcp`
verifies an unpublished matching core tarball through a consumer-only npm
override; the published MCP manifest always retains the registry alias.
*/
import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';
import { createHash } from 'node:crypto';
import { dirname, join } from 'node:path';
import { Port, run, cd, fetchSource, readJson, writeJson, requirePackage, recipeContext } from '../../../cli/recipe.mjs';
import { mkdirSync, readdirSync, readFileSync, renameSync, rmSync } from 'node:fs';

const version = '0.0.84';
const rootDir = import.meta.dirname;
const buildDir = join(rootDir, 'build');
const packageDir = join(buildDir, `playwright-mcp-${version}`);
const hashesFile = join(buildDir, 'upstream-hashes.json');

function hash(file) {
  return createHash('sha256').update(readFileSync(file)).digest('hex');
}

function filesBelow(directory) {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const file = join(directory, entry.name);
    return entry.isDirectory() ? filesBelow(file) : entry.isFile() ? [file] : [];
  });
}

function assertNoElfFiles(directory) {
  const elfFiles = filesBelow(directory).filter((file) => readFileSync(file).subarray(0, 4).toString('hex') === '7f454c46');
  assert.deepEqual(elfFiles, [], `unexpected ELF files in artifact: ${elfFiles.join(' ')}`);
}

function verifyStdio(cli) {
  return new Promise((resolve, reject) => {
    const child = spawn(process.execPath, [cli], { stdio: ['pipe', 'pipe', 'inherit'] });
    let buffer = '';
    let settled = false;
    const timer = setTimeout(() => finish(Error('handshake timeout')), 30000);
    function finish(error) {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      if (child.exitCode === null && child.signalCode === null) child.kill();
      if (error) reject(error);
      else resolve();
    }
    child.once('error', finish);
    child.once('close', (code, signal) => {
      if (!settled) finish(Error(`MCP exited before handshake completed: ${signal ?? code}`));
    });
    child.stdin.once('error', finish);
    child.stdout.on('data', (chunk) => {
      buffer += chunk.toString('utf8');
      let index;
      while ((index = buffer.indexOf('\n')) >= 0) {
        const line = buffer.slice(0, index).trim();
        buffer = buffer.slice(index + 1);
        if (!line) continue;
        let message;
        try {
          message = JSON.parse(line);
        } catch {
          continue;
        }
        try {
          if (message.id === 1) {
            assert.ok(message.result, `bad initialize response: ${line}`);
            console.log('stdio initialize OK:', message.result.serverInfo?.name, message.result.serverInfo?.version);
            child.stdin.write(`${JSON.stringify({ jsonrpc: '2.0', id: 2, method: 'tools/list' })}\n`);
          } else if (message.id === 2) {
            const names = (message.result?.tools ?? []).map((tool) => tool.name);
            assert.ok(names.length > 0, `bad tools/list response: ${line}`);
            for (const required of ['browser_navigate', 'browser_snapshot', 'browser_take_screenshot']) {
              assert.ok(names.includes(required), `missing MCP tool: ${required}`);
            }
            console.log('stdio tools/list OK:', names.length, 'tools');
            finish();
            return;
          }
        } catch (error) {
          finish(error);
          return;
        }
      }
    });
    child.stdin.write(`${JSON.stringify({
      jsonrpc: '2.0',
      id: 1,
      method: 'initialize',
      params: {
        protocolVersion: '2025-06-18',
        capabilities: {},
        clientInfo: { name: 'port-smoke', version: '0' },
      },
    })}\n`);
  });
}

export default class PlaywrightMcp extends Port {
  static pkgname = 'playwright-mcp';
  static upstream = '@playwright/mcp';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [`build/playwright-mcp-${version}`];
  static source = `https://registry.npmjs.org/@playwright/mcp/-/mcp-${version}.tgz`;
  static sha256 = '4e749bdc5a19138fed51cf0f51e43dca265c1bfc0fc388220fc70756aac60c26';

  prepare() {
    mkdirSync(buildDir, { recursive: true });
    cd(buildDir);
    fetchSource('mcp.tgz');
    rmSync('package', { recursive: true, force: true });
    rmSync(packageDir, { recursive: true, force: true });
    run('tar', ['-zxf', 'mcp.tgz']);
    rmSync('mcp.tgz');
    renameSync('package', packageDir);
    const hashes = Object.fromEntries(
      readdirSync(packageDir)
        .filter((file) => file !== 'package.json')
        .map((file) => [file, hash(join(packageDir, file))]),
    );
    writeJson(hashesFile, hashes);
  }

  build() {
    cd(packageDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0001-update-package-json.patch')) });
    for (const [file, expected] of Object.entries(readJson(hashesFile))) {
      assert.equal(hash(join(packageDir, file)), expected, file);
    }

    const pkg = readJson(join(packageDir, 'package.json'));
    assert.equal(pkg.dependencies['playwright-core'], 'npm:@ohos-npm-ports/playwright-core@1.64.1-1');
    assert.ok(!('playwright' in pkg.dependencies), 'unused playwright dep must be dropped');
    run(process.execPath, ['--check', join(packageDir, 'cli.js')]);
    run(process.execPath, ['--check', join(packageDir, 'index.js')]);
    assertNoElfFiles(packageDir);
  }

  static testPrerequisites = ['ports/p/playwright-core'];
  static testTimeout = 600_000;

  testSetup() {
    const context = recipeContext();
    if (!process.env.PLAYWRIGHT_CORE_TARBALL || context.mode === 'baseline') return;
    const file = join(context.projectDir, 'package.json');
    const pkg = readJson(file);
    pkg.overrides ??= {};
    pkg.overrides['playwright-core'] = `file:${process.env.PLAYWRIGHT_CORE_TARBALL}`;
    writeJson(file, pkg);
  }

  async test() {
    const context = recipeContext();
    const core = requirePackage('playwright-core/package.json');
    if (context.mode === 'overrides') assert.equal(core.name, '@ohos-npm-ports/playwright-core');
    const manifestPath = context.resolvePackage('@playwright/mcp/package.json');
    const cli = join(dirname(manifestPath), 'cli.js');
    const versionOutput = run(process.execPath, [cli, '--version'], { capture: true }).stdout;
    assert.ok(versionOutput.includes(`Version ${version}`), versionOutput);
    run(process.execPath, [cli, '--help']);

    const { tools } = requirePackage('playwright-core/lib/coreBundle');
    const names = tools.browserTools.map((tool) => tool.schema?.name ?? tool.name).filter(Boolean);
    for (const required of ['browser_navigate', 'browser_click', 'browser_snapshot', 'browser_take_screenshot', 'browser_evaluate']) {
      assert.ok(names.includes(required), `missing tool: ${required}`);
    }
    const mcp = requirePackage('@playwright/mcp');
    assert.equal(typeof mcp.createConnection, 'function');
    await verifyStdio(cli);
    return {
      result: {
        cliVersion: version,
        createConnection: true,
        browserTools: true,
        stdio: true,
      },
      assets: [],
    };
  }
}
