#!/usr/bin/env node
/*
@ohos-npm-ports/pnpm 12.16.1

1. Download the pnpm source tag and upstream npm wrapper.
2. Patch host platform reporting, vendor iana-time-zone with runtime dlopen,
   and use the OpenHarmony temporary directory for store operation locks.
3. Build and strip pnpm-cli with cargo.
4. Put the binary in @ohos-npm-ports/pnpm-exe.openharmony-arm64.
5. Repack the upstream wrapper with its native-binary.mjs OpenHarmony branch.
*/
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { dirname, join, relative } from 'node:path';
import { tmpdir } from 'node:os';
import { Port, resource, run, cd, fetchSource, fetchResource, readJson, writeJson, requirePackage, importPackage, recipeContext } from '../../../cli/recipe.mjs';
import { chmodSync, copyFileSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, renameSync, rmSync } from 'node:fs';

const version = '12.16.1';
const slotName = 'pnpm-exe.openharmony-arm64';
const ianaTimeZoneSha256 = 'e31bc9ad994ba00e440a8aa5c9ef0ec67d5cb5e5cb0cc7f8b744a35b389cc470';
const rootDir = import.meta.dirname;
const buildDir = join(rootDir, 'build');
const sourceDir = join(buildDir, `pnpm-${version}`);
const slotDir = join(buildDir, slotName);
const mainDir = join(buildDir, `pnpm-wrapper-${version}`);

function filesBelow(directory) {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const file = join(directory, entry.name);
    return entry.isDirectory() ? filesBelow(file) : [file];
  }).sort();
}

function hashTree(directory) {
  return Object.fromEntries(filesBelow(directory).map((file) => [
    relative(directory, file),
    createHash('sha256').update(readFileSync(file)).digest('hex'),
  ]));
}

function verifyWrapper() {
  const current = hashTree(mainDir);
  const pristine = readJson(join(buildDir, 'wrapper-pristine.json'));
  const allowed = new Set(['package.json', 'native-binary.mjs']);
  for (const file of new Set([...Object.keys(pristine), ...Object.keys(current)])) {
    assert.ok(pristine[file] === current[file] || allowed.has(file), `wrapper drift beyond patched files: ${file}`);
  }
}

function verifyLoaderPlatforms() {
  const script = `
    Object.defineProperty(process, 'platform', { value: process.argv[1] });
    const m = await import('./native-binary.mjs');
    const candidates = m.getBinCandidates();
    if (process.argv[1] === 'openharmony') {
      if (candidates.length !== 1 || candidates[0] !== '@ohos-npm-ports/pnpm-exe.openharmony-arm64/pnpm')
        throw new Error('openharmony: ' + JSON.stringify(candidates));
    } else if (candidates.length === 0 || !candidates.every((name) => name.startsWith('@pnpm/exe.'))) {
      throw new Error(process.argv[1] + ': ' + JSON.stringify(candidates));
    }
  `;
  for (const platform of ['openharmony', 'linux', 'darwin', 'win32']) {
    run(process.execPath, ['--input-type=module', '-e', script, platform], { cwd: mainDir });
  }
}

export default class Pnpm extends Port {
  static pkgname = 'pnpm';
  static upstream = 'pnpm';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [
    '@ohos-npm-ports/pnpm-exe.openharmony-arm64:build/pnpm-exe.openharmony-arm64',
    `build/pnpm-wrapper-${version}`,
  ];
  static source = `https://github.com/pnpm/pnpm/archive/refs/tags/v${version}.tar.gz`;
  static sha256 = 'baaffdb2671a414882d13379d978339a58a9e66fe099f1f00f05a47b6232322c';
  static resources = [
    resource(
      'npm',
      `https://registry.npmjs.org/pnpm/-/pnpm-${version}.tgz`,
      'ca362a16f2e1c3cfa81d406f3242446179a0e4aea457ba3e9e6c39e6476aba65',
    ),
    resource(
      'iana_time_zone',
      'https://static.crates.io/crates/iana-time-zone/iana-time-zone-0.1.65.crate',
      ianaTimeZoneSha256,
    ),
  ];

  prepare() {
    console.log('=== deps: toolchain ===');
    mkdirSync('/data/storage/el2/base/cache', { recursive: true });
    mkdirSync('/data/storage/el2/base/file', { recursive: true });
    run('brew', ['install', '-y', 'cmake', 'pkgconf']);
    run('cargo', ['--version']);

    console.log('=== fetch: sources ===');
    rmSync(buildDir, { recursive: true, force: true });
    mkdirSync(buildDir, { recursive: true });
    cd(buildDir);
    fetchSource(join(buildDir, 'pnpm-src.tar.gz'));
    fetchResource('npm', join(buildDir, 'pnpm-npm.tgz'));
    fetchResource('iana_time_zone', join(buildDir, 'iana-time-zone.crate'));
    run('tar', ['-zxf', join(buildDir, 'pnpm-src.tar.gz'), '-C', buildDir]);
    mkdirSync(join(buildDir, 'wrapper'));
    run('tar', ['-zxf', join(buildDir, 'pnpm-npm.tgz'), '-C', join(buildDir, 'wrapper')]);
    writeJson(join(buildDir, 'wrapper-pristine.json'), hashTree(join(buildDir, 'wrapper/package')));
  }

  build() {
    console.log('=== build: patch + cargo ===');
    rmSync(join(sourceDir, '.cargo/config.toml'), { force: true });
    for (const patch of [
      '0001-host-platform-openharmony.patch',
      '0002-iana-time-zone-vendor.patch',
      '0003-cargo-lock-iana-time-zone.patch',
      '0007-use-ohos-tempdir.patch',
    ]) {
      run('patch', ['-p1'], { cwd: sourceDir, input: readFileSync(join(rootDir, 'patches', patch)) });
    }

    mkdirSync(join(sourceDir, 'vendor'), { recursive: true });
    run('tar', ['-zxf', join(buildDir, 'iana-time-zone.crate'), '-C', join(sourceDir, 'vendor')]);
    renameSync(join(sourceDir, 'vendor/iana-time-zone-0.1.65'), join(sourceDir, 'vendor/iana-time-zone'));
    run('patch', ['-p1'], {
      cwd: sourceDir,
      input: readFileSync(join(rootDir, 'patches/0004-iana-time-zone-dlopen.patch')),
    });

    assert.ok(readFileSync(join(sourceDir, 'pnpm/crates/detect-libc/src/lib.rs'), 'utf8').includes('openharmony'));
    assert.ok(readFileSync(join(sourceDir, 'Cargo.toml'), 'utf8').includes('iana-time-zone = { path'));
    assert.ok(!readFileSync(join(sourceDir, 'Cargo.lock'), 'utf8').includes(ianaTimeZoneSha256));
    assert.ok(readFileSync(join(sourceDir, 'vendor/iana-time-zone/src/tz_ohos.rs'), 'utf8').includes('dlopen'));
    // OpenHarmony has a read-only /tmp; all processes must share this lock root
    // even when XDG_RUNTIME_DIR is unavailable and TMPDIR differs.
    assert.ok(readFileSync(join(sourceDir, 'pnpm/crates/fs/src/secure_temp_lock.rs'), 'utf8')
      .includes('OHOS_TEMP_DIR: &str = "/data/storage/el2/base/cache"'));

    run('cargo', ['install', '--locked', '--path', 'pnpm/crates/cli', '--root', join(buildDir, 'cargo-root')], {
      cwd: sourceDir,
      env: { AWS_LC_SYS_NO_JITTER_ENTROPY: '1' },
    });
    const binary = join(buildDir, 'cargo-root/bin/pnpm');
    assert.ok(existsSync(binary));
    run(binary, ['--version']);
    run('llvm-strip', ['--strip-all', binary, '-o', join(buildDir, 'pnpm-bin')]);
    chmodSync(join(buildDir, 'pnpm-bin'), 0o755);
  }

  package() {
    console.log('=== package: slot + main ===');
    rmSync(slotDir, { recursive: true, force: true });
    mkdirSync(slotDir, { recursive: true });
    copyFileSync(join(buildDir, 'pnpm-bin'), join(slotDir, 'pnpm'));
    chmodSync(join(slotDir, 'pnpm'), 0o755);
    writeJson(join(slotDir, 'package.json'), {
      version,
      license: 'MIT',
      os: ['openharmony'],
      cpu: ['arm64'],
      publishConfig: { executableFiles: ['./pnpm'] },
    });

    renameSync(join(buildDir, 'wrapper/package'), mainDir);
    for (const patch of ['0005-update-package-json.patch', '0006-native-binary-openharmony.patch']) {
      run('patch', ['-p1'], { cwd: mainDir, input: readFileSync(join(rootDir, 'patches', patch)) });
    }
    assert.ok(readFileSync(join(mainDir, 'native-binary.mjs'), 'utf8')
      .includes('@ohos-npm-ports/pnpm-exe.openharmony-arm64/pnpm'));
    verifyWrapper();

    const mainPkg = readJson(join(mainDir, 'package.json'));
    const slotPkg = readJson(join(slotDir, 'package.json'));
    assert.equal(mainPkg.version, version);
    assert.equal(slotPkg.version, mainPkg.version);
    assert.equal(mainPkg.optionalDependencies[`@ohos-npm-ports/${slotName}`], slotPkg.version);
    assert.deepEqual(slotPkg.os, ['openharmony']);
    assert.deepEqual(slotPkg.cpu, ['arm64']);
    run(join(slotDir, 'pnpm'), ['--version']);
    assert.equal(readFileSync(join(slotDir, 'pnpm')).subarray(0, 4).toString('hex'), '7f454c46');
    verifyLoaderPlatforms();
    assert.ok(existsSync(slotDir));
    assert.ok(existsSync(mainDir));
  }

  static testTimeout = 600_000;

  async test() {
    const context = recipeContext();
    const pkg = requirePackage('pnpm/package.json');
    if (context.mode === 'overrides') {
      assert.equal(pkg.name, '@ohos-npm-ports/pnpm');
      assert.equal(pkg.version, context.portVersion);
      assert.equal(pkg.optionalDependencies[`@ohos-npm-ports/${slotName}`], context.portVersion);
    } else {
      assert.equal(pkg.name, 'pnpm');
      assert.equal(pkg.version, version);
    }

    const native = await importPackage('pnpm/native-binary.mjs');
    const candidates = native.getBinCandidates();
    assert.ok(candidates.length > 0, 'no native binary candidate for the host');
    const expectedPrefix = process.platform === 'openharmony' ? '@ohos-npm-ports/pnpm-exe.' : '@pnpm/exe.';
    assert.ok(candidates.every((name) => name.startsWith(expectedPrefix)), JSON.stringify(candidates));
    const installedBinary = native.resolveInstalledBinary();
    assert.ok(installedBinary, 'installed native binary missing');
    assert.ok(existsSync(installedBinary));

    const root = dirname(context.resolvePackage('pnpm/package.json'));
    const binary = join(root, process.platform === 'win32' ? 'pnpm.exe' : 'pnpm');
    assert.ok(existsSync(binary));
    if (process.platform === 'openharmony') {
      assert.equal(readFileSync(binary).subarray(0, 4).toString('hex'), '7f454c46');
    }
    const output = run(binary, ['--version'], { capture: true }).stdout;
    assert.ok(output.includes(version), output);

    const smoke = mkdtempSync(join(tmpdir(), 'pnpm-port-'));
    try {
      writeJson(join(smoke, 'package.json'), { name: 'smoke' });
      run(binary, ['install', '--lockfile-only'], { cwd: smoke });
      assert.ok(existsSync(join(smoke, 'pnpm-lock.yaml')));
    } finally {
      rmSync(smoke, { recursive: true, force: true });
    }
    return {
      result: { cliVersion: version, nativeLoader: true, lockfileOnlyInstall: true },
      assets: [],
    };
  }
}
