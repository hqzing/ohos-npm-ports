#!/usr/bin/env node
/*
@ohos-npm-ports/prisma-client 7.10.1

Download the official @prisma/client tarball, validate its manifest, and repack
without compiling. Every shipped file except package.json is checked against
the pristine upstream tree. Prisma 7 ships its query compiler as WASM and uses
a consumer-supplied driver adapter, so it needs no OpenHarmony Rust engine
override and has no native addon. Consumer tests generate a client and run CRUD
through a pure-JavaScript sql.js adapter with Node and, when available, bun.
*/
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { dirname, join, relative } from 'node:path';
import { Port, run, cd, fetchSource, readJson, writeJson, requirePackage, recipeContext } from '../../../cli/recipe.mjs';
import { cpSync, mkdirSync, readdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs';

const version = '7.10.1';
const rootDir = import.meta.dirname;
const buildDir = join(rootDir, 'build');
const sourceDir = join(buildDir, 'src');
const packageDir = join(buildDir, 'pkg');

const schema = `generator client {
  provider              = "prisma-client"
  output                = "./client"
  runtime               = "nodejs"
  moduleFormat          = "cjs"
  importFileExtension   = "js"
}
datasource db {
  provider = "sqlite"
}
model Widget {
  id   Int    @id @default(autoincrement())
  name String
}
`;

const adapter = `const path = require("path");
const initSqlJs = require("sql.js");

// ColumnTypeEnum values from @prisma/driver-adapter-utils.
const ColumnType = { Int32: 0, Int64: 1, Double: 3, Boolean: 5, Text: 7, Bytes: 13 };

function columnType(value) {
  if (typeof value === "boolean") return ColumnType.Boolean;
  if (typeof value === "bigint") return ColumnType.Int64;
  if (typeof value === "number") return Number.isInteger(value) ? ColumnType.Int32 : ColumnType.Double;
  if (value instanceof Uint8Array) return ColumnType.Bytes;
  return ColumnType.Text;
}

function createAdapter(SQL) {
  const db = new SQL.Database();
  const adapter = {
    provider: "sqlite",
    adapterName: "ohos-prisma-client-smoke",
    async queryRaw(query) {
      const args = query.args ?? [];
      const stmt = db.prepare(query.sql);
      if (args.length) stmt.bind(args);
      const columnNames = stmt.getColumnNames();
      const rows = [];
      while (stmt.step()) rows.push(stmt.get());
      stmt.free();
      const columnTypes = columnNames.map((_, i) => columnType(rows.find((row) => row[i] != null)?.[i]));
      return { columnNames, columnTypes, rows };
    },
    async executeRaw(query) {
      db.run(query.sql, query.args ?? []);
      return db.getRowsModified();
    },
    async executeScript(script) {
      db.exec(script);
    },
    async startTransaction() {
      db.run("BEGIN");
      return {
        provider: "sqlite",
        adapterName: adapter.adapterName,
        options: { usePhantomQuery: false },
        queryRaw: adapter.queryRaw,
        executeRaw: adapter.executeRaw,
        commit: async () => db.run("COMMIT"),
        rollback: async () => db.run("ROLLBACK"),
      };
    },
    async dispose() {
      db.close();
    },
  };
  return adapter;
}

async function connect() {
  const SQL = await initSqlJs({
    locateFile: (file) => path.join(path.dirname(require.resolve("sql.js/dist/sql-wasm.js")), file),
  });
  return createAdapter(SQL);
}

module.exports = { connect };
`;

const smoke = `const { connect } = require("./sqljs-adapter.cjs");
const { PrismaClient } = require("./generated/client.js");

(async () => {
  const adapter = await connect();
  await adapter.executeScript(
    'CREATE TABLE "Widget" ("id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, "name" TEXT NOT NULL)',
  );
  const factory = { provider: "sqlite", adapterName: adapter.adapterName, connect: async () => adapter };
  const p = new PrismaClient({ adapter: factory });
  const w = await p.widget.create({ data: { name: "smoke" } });
  const f = await p.widget.findUnique({ where: { id: w.id } });
  if (!f || f.name !== "smoke") throw new Error("read-back failed");
  const n = await p.widget.count();
  if (n !== 1) throw new Error("bad count: " + n);
  await p.$disconnect();
  console.log("CRUD OK");
})().catch((e) => { console.error(e); process.exit(1); });
`;

function filesBelow(directory) {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const file = join(directory, entry.name);
    return entry.isDirectory() ? filesBelow(file) : [file];
  }).sort();
}

function hashTree(directory) {
  return Object.fromEntries(filesBelow(directory).map((file) => [
    relative(directory, file),
    createHash('sha256').update(readFileSync(file)).digest('hex'),
  ]));
}

function commandAvailable(command) {
  try {
    run(command, ['--version'], { capture: true });
    return true;
  } catch (error) {
    if (error.code === 'ENOENT') return false;
    throw error;
  }
}

export default class PrismaClient extends Port {
  static pkgname = 'prisma-client';
  static upstream = '@prisma/client';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = ['build/pkg'];
  static source = `https://registry.npmjs.org/@prisma/client/-/client-${version}.tgz`;
  static sha256 = 'f61ebcb6989355c08edeb0596753d8afee6429eadab7b50074dedcb220cfc622';

  prepare() {
    console.log(`=== fetch: 官方 @prisma/client@${version} ===`);
    rmSync(buildDir, { recursive: true, force: true });
    mkdirSync(buildDir, { recursive: true });
    cd(buildDir);
    fetchSource('src.tgz');
    run('tar', ['-zxf', 'src.tgz']);
    rmSync('src.tgz');
    renameSync('package', 'src');
    writeJson(join(buildDir, 'pristine.json'), hashTree(sourceDir));
  }

  build() {
    console.log('=== build: 校验上游 manifest ===');
    cd(sourceDir);
    assert.equal(readJson(join(sourceDir, 'package.json')).version, version);
  }

  package() {
    console.log('=== package: 组装发布目录 + pristine 对账 ===');
    rmSync(packageDir, { recursive: true, force: true });
    cpSync(sourceDir, packageDir, { recursive: true, verbatimSymlinks: true });
    rmSync(join(packageDir, 'node_modules'), { recursive: true, force: true });

    const pristineFile = join(buildDir, 'pristine.json');
    const pristine = readJson(pristineFile);
    const current = hashTree(packageDir);
    delete pristine['package.json'];
    delete current['package.json'];
    assert.deepEqual(current, pristine);
    rmSync(pristineFile);

    const pkg = readJson(join(packageDir, 'package.json'));
    assert.equal(pkg.version, version);
    for (const file of ['default.js', 'index.js', 'runtime/client.js', 'runtime/client.mjs', 'scripts/default-index.js']) {
      assert.ok(statSync(join(packageDir, file)).isFile());
      run(process.execPath, ['--check', join(packageDir, file)]);
    }
  }

  static testTimeout = 1_800_000;

  testSetup() {
    const context = recipeContext();
    const projectFile = join(context.projectDir, 'package.json');
    const project = readJson(projectFile);
    project.dependencies ??= {};
    Object.assign(project.dependencies, {
      prisma: version,
      'sql.js': '1.15.2',
      typescript: '5.9.3',
    });
    writeJson(projectFile, project);
    const app = join(context.projectDir, 'app');
    mkdirSync(app, { recursive: true });
    writeFileSync(join(app, 'schema.prisma'), schema);
    writeFileSync(join(app, 'sqljs-adapter.cjs'), adapter);
    writeFileSync(join(app, 'smoke.cjs'), smoke);
  }

  test() {
    const context = recipeContext();
    const app = join(context.projectDir, 'app');
    const pkg = requirePackage('@prisma/client/package.json');
    assert.equal(pkg.version, context.mode === 'overrides' ? context.portVersion : version);
    assert.equal(pkg.name, context.mode === 'overrides' ? '@ohos-npm-ports/prisma-client' : '@prisma/client');

    const cliPkg = requirePackage('prisma/package.json');
    const cli = join(dirname(context.resolvePackage('prisma/package.json')), cliPkg.bin.prisma);
    const generated = run(process.execPath, [cli, 'generate', '--schema', 'schema.prisma'], { cwd: app, capture: true });
    assert.ok(`${generated.stdout}${generated.stderr}`.includes('Generated Prisma Client'));

    const typescriptPkg = requirePackage('typescript/package.json');
    const tsc = join(dirname(context.resolvePackage('typescript/package.json')), typescriptPkg.bin.tsc);
    run(process.execPath, [
      tsc,
      '--module', 'commonjs',
      '--target', 'es2022',
      '--moduleResolution', 'node',
      '--esModuleInterop',
      '--skipLibCheck',
      '--outDir', 'generated',
      'client/client.ts',
    ], { cwd: app });
    run(process.execPath, ['smoke.cjs'], { cwd: app });
    const bun = commandAvailable('bun');
    if (bun) run('bun', ['smoke.cjs'], { cwd: app });
    return {
      result: { generate: true, crud: true, bunCrud: bun },
      assets: [],
    };
  }
}
