#!/usr/bin/env node
import assert from 'node:assert/strict';
import { chmodSync, cpSync, existsSync, lstatSync, mkdirSync, mkdtempSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { Port, resource, run, cd, fetchSource, fetchResource, requirePackage } from '../../../cli/recipe.mjs';

const version = '5.1.1';
const commit = '6a3747c37ff169c90047725a05a6ef02e32ac97e';
const rootDir = import.meta.dirname;
const buildDir = join(rootDir, 'build');
const sourceDir = join(buildDir, 'src');
const packageDir = join(buildDir, 'pkg');

export default class PrismaEngines extends Port {
  static pkgname = 'prisma-engines';
  static upstream = '@prisma/engines';
  static version = version;
  static revision = 5;
  static bump = false;
  static distTag = 'latest';
  static packages = ['build/pkg'];
  static source = `https://github.com/prisma/prisma-engines/archive/${commit}.tar.gz`;
  static sha256 = 'f4dee7fa06aa95115f46aa1cdaeeca591533313a27aaa59a74665f84009dd6f1';
  static resources = [
    resource('rust_dist', 'https://static.rust-lang.org/dist/2026-08-20/rust-1.98.0-aarch64-unknown-linux-ohos.tar.gz', 'db1b3c28a89a71594e9366b952ea5b34f7f9c66c853db7c3c637e59906cfcbc0'),
    resource('socket2', 'https://static.crates.io/crates/socket2/socket2-0.4.7.crate', '02e2d2db9033d13a1567121ddd7a095ee144db4e1ca1b1bda3419bc0da294ebd'),
    resource('openssl_src', 'https://static.crates.io/crates/openssl-src/openssl-src-111.25.0+1.1.1t.crate', '3173cd3626c43e3854b1b727422a276e568d9ec5fe8cec197822cf52cfb743d6'),
  ];
  prepare() {
    // Use the official Rust distribution: the bottle's newer sysroot produces
    // binaries that reference __fd_chk and cannot load in the CI container.
    run('brew', ['install', '-y', 'openssl@3', 'libxml2', 'zlib']);
    rmSync(buildDir, { recursive: true, force: true });
    mkdirSync(buildDir, { recursive: true });

    const rustArchive = join(buildDir, 'rust-dist.tar.gz');
    const rustExtractDir = join(buildDir, 'rust-dist-extract');
    const rustHome = join(buildDir, 'rust-dist');
    fetchResource('rust_dist', rustArchive);
    mkdirSync(rustExtractDir);
    run('tar', ['-zxf', rustArchive, '-C', rustExtractDir, '--strip-components=1']);
    rmSync(rustArchive);
    run('sh', [join(rustExtractDir, 'install.sh'), `--prefix=${rustHome}`, '--disable-ldconfig', '--components=rustc,cargo,rust-std-aarch64-unknown-linux-ohos']);
    rmSync(rustExtractDir, { recursive: true, force: true });

    const sourceArchive = join(buildDir, 'src.tar.gz');
    fetchSource(sourceArchive);
    run('tar', ['-zxf', sourceArchive, '-C', buildDir]);
    rmSync(sourceArchive);
    renameSync(join(buildDir, `prisma-engines-${commit}`), sourceDir);
  }

  build() {
    cd(sourceDir);
    for (const patch of [
      '0001-workspace-config-ohos.patch',
      '0002-rustc-compat-fixes.patch',
      '0005-build-rs-no-git-required.patch',
    ]) {
      run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches', patch)) });
    }
    assert.ok(readFileSync('Cargo.toml', 'utf8').includes('[patch.crates-io]'));
    assert.ok(readFileSync('libs/user-facing-errors/src/lib.rs', 'utf8').includes('PanicHookInfo'));
    assert.ok(readFileSync('query-engine/query-engine-node-api/build.rs', 'utf8').includes('GIT_HASH=6a3747c'));
    assert.ok(readFileSync('schema-engine/cli/build.rs', 'utf8').includes('GIT_HASH=6a3747c'));

    mkdirSync('vendor', { recursive: true });
    const socketArchive = join(sourceDir, 'socket2.crate');
    const socketDir = join(sourceDir, 'vendor/socket2-0.4.7');
    fetchResource('socket2', socketArchive);
    mkdirSync(socketDir, { recursive: true });
    run('tar', ['-zxf', socketArchive, '-C', socketDir, '--strip-components=1']);
    rmSync(socketArchive);
    run('patch', ['-p1'], { cwd: socketDir, input: readFileSync(join(rootDir, 'patches/0003-socket2-ohos-target.patch')) });
    assert.ok(readFileSync(join(socketDir, 'src/sys/unix.rs'), 'utf8').includes('target_env = "ohos"'));

    const opensslArchive = join(sourceDir, 'openssl-src.crate');
    const opensslDir = join(sourceDir, 'vendor/openssl-src-111.25.0+1.1.1t');
    fetchResource('openssl_src', opensslArchive);
    mkdirSync(opensslDir, { recursive: true });
    run('tar', ['-zxf', opensslArchive, '-C', opensslDir, '--strip-components=1']);
    rmSync(opensslArchive);
    run('patch', ['-p1'], { cwd: opensslDir, input: readFileSync(join(rootDir, 'patches/0004-openssl-src-ohos-target.patch')) });
    assert.ok(readFileSync(join(opensslDir, 'src/lib.rs'), 'utf8').includes('aarch64-unknown-linux-ohos'));

    try {
      run('curl', ['-fsIL', '--max-time', '8', '-o', '/dev/null', 'https://index.crates.io/config.json'], { capture: true });
    } catch {
      process.env.CARGO_REGISTRIES_CRATES_IO_INDEX = 'sparse+https://rsproxy.cn/index/';
    }

    process.env.PATH = `${join(buildDir, 'rust-dist/bin')}:${process.env.PATH}`;
    const opensslPrefix = run('brew', ['--prefix', 'openssl@3'], { capture: true }).stdout.trim();
    const libxmlPrefix = run('brew', ['--prefix', 'libxml2'], { capture: true }).stdout.trim();
    const zlibPrefix = run('brew', ['--prefix', 'zlib'], { capture: true }).stdout.trim();
    const brewPrefix = run('brew', ['--prefix'], { capture: true }).stdout.trim();
    process.env.LD_LIBRARY_PATH = `${opensslPrefix}/lib:${libxmlPrefix}/lib:${zlibPrefix}/lib`;
    process.env.CARGO_HTTP_CAINFO = join(brewPrefix, 'etc/openssl@3/cert.pem');
    process.env.LIBZ_SYS_STATIC = '1';
    run('cargo', ['--version']);

    // Vendored OpenSSL avoids target pkg-config wiring. The stub satisfies the
    // older container libc's missing __fd_chk hardening hook.
    writeFileSync('fdchk-stub.c', 'void __fd_chk(long fd) { (void)fd; }\n');
    run('cc', ['-c', 'fdchk-stub.c', '-o', 'fdchk-stub.o']);
    process.env.RUSTFLAGS = `-C link-arg=${join(sourceDir, 'fdchk-stub.o')}`;
    run('cargo', ['build', '--release', '-p', 'query-engine-node-api', '-p', 'schema-engine-cli', '--features', 'vendored-openssl']);
    assert.ok(existsSync('target/release/libquery_engine.so'), 'query engine .so missing');
    assert.ok(existsSync('target/release/schema-engine'), 'schema engine binary missing');
  }

  package() {
    rmSync(packageDir, { recursive: true, force: true });
    mkdirSync(packageDir);
    cpSync(join(sourceDir, 'target/release/libquery_engine.so'), join(packageDir, 'libquery_engine.so'));
    cpSync(join(sourceDir, 'target/release/schema-engine'), join(packageDir, 'schema-engine'));
    cpSync(join(rootDir, 'package.json'), join(packageDir, 'package.json'));
    cpSync(join(rootDir, 'index.js'), join(packageDir, 'index.js'));
    run('llvm-strip', ['--strip-all', join(packageDir, 'libquery_engine.so')]);
    run('llvm-strip', ['--strip-all', join(packageDir, 'schema-engine')]);
    chmodSync(join(packageDir, 'schema-engine'), 0o755);

    // Real alias copies support Prisma's binaryTarget fallback. Symlinks are
    // unsuitable because npm pack drops them and Node resolves them before loading.
    cd(packageDir);
    cpSync('libquery_engine.so', 'libquery_engine-debian-openssl-1.1.x.so.node');
    cpSync('schema-engine', 'schema-engine-debian-openssl-1.1.x');
    cpSync('libquery_engine.so', 'libquery_engine-debian-openssl-3.0.x.so.node');
    cpSync('schema-engine', 'schema-engine-debian-openssl-3.0.x');
    for (const file of [
      'libquery_engine-debian-openssl-1.1.x.so.node',
      'schema-engine-debian-openssl-1.1.x',
      'libquery_engine-debian-openssl-3.0.x.so.node',
      'schema-engine-debian-openssl-3.0.x',
    ]) {
      const stat = lstatSync(file);
      assert.ok(stat.isFile() && !stat.isSymbolicLink(), `alias missing or not a regular file: ${file}`);
    }
  }

  static testPlatforms = ['openharmony'];
  static testPlatformReason = 'The native Prisma engines and CLI round-trip require the OpenHarmony runtime.';

  async test() {
    const engines = requirePackage('@prisma/engines');
    for (const key of [
      'getEnginesPath',
      'ensureBinariesExist',
      'getCliQueryEngineBinaryType',
      'enginesVersion',
      'DEFAULT_CLI_QUERY_ENGINE_BINARY_TYPE',
    ]) {
      assert.notEqual(engines[key], undefined, `missing compat export: ${key}`);
    }
    assert.equal(engines.DEFAULT_CLI_QUERY_ENGINE_BINARY_TYPE, 'libquery-engine');
    assert.equal(engines.enginesVersion, commit);
    const enginesPath = engines.getEnginesPath();
    const queryAlias = join(enginesPath, 'libquery_engine-debian-openssl-1.1.x.so.node');
    assert.ok(existsSync(queryAlias));
    assert.ok(existsSync(join(enginesPath, 'schema-engine-debian-openssl-1.1.x')));
    const library = requirePackage(queryAlias);
    assert.equal(library.version().commit, commit);

    const directory = mkdtempSync(join(tmpdir(), 'prisma-engines-smoke-'));
    const previousDirectory = process.cwd();
    let prisma;
    try {
      cd(directory);
      writeFileSync('schema.prisma', `generator client {
  provider = "prisma-client-js"
  output   = "client"
}
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}
model Widget {
  id   Int    @id @default(autoincrement())
  name String
}
`);
      process.env.PRISMA_SCHEMA_ENGINE_BINARY = engines.schemaEngineBinaryPath;
      process.env.PRISMA_QUERY_ENGINE_LIBRARY = engines.queryEngineLibraryPath;
      run('npx', ['--yes', `prisma@${version}`, 'db', 'push', '--schema', 'schema.prisma', '--skip-generate']);
      run('npx', ['--yes', `prisma@${version}`, 'generate', '--schema', 'schema.prisma']);

      const { PrismaClient } = requirePackage(join(directory, 'client'));
      prisma = new PrismaClient();
      const widget = await prisma.widget.create({ data: { name: 'smoke-test' } });
      assert.equal(widget.name, 'smoke-test');
      const found = await prisma.widget.findUnique({ where: { id: widget.id } });
      assert.equal(found?.name, 'smoke-test', 'read-back failed');
      return {
        result: { commit, compatibility: true, row: found.name, roundTrip: true },
        assets: [],
      };
    } finally {
      try {
        if (prisma) await prisma.$disconnect();
      } finally {
        cd(previousDirectory);
        rmSync(directory, { recursive: true, force: true });
      }
    }
  }
}
