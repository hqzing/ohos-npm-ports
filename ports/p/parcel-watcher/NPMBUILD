#!/usr/bin/env node
import assert from 'node:assert/strict';
import { Port, resource, run, cd, fetchSource, fetchResource, readJson, writeJson, requirePackage } from '../../../cli/recipe.mjs';
import { copyFileSync, existsSync, mkdirSync, mkdtempSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';

const version = '2.6.0';
const rootDir = import.meta.dirname;
const sourceDir = join(rootDir, `watcher-${version}`);
const packageDir = join(rootDir, `parcel-watcher-${version}`);
const slotDir = join(rootDir, 'slots/openharmony-arm64');
const slotSourceDir = join(slotDir, `watcher-${version}`);
const slotPackageDir = join(slotDir, `parcel-watcher-openharmony-arm64-${version}`);

function applyPatch(directory, patch) {
  run('patch', ['-p1'], { cwd: directory, input: readFileSync(patch) });
}

function verifyBindingPatch(directory) {
  const binding = readFileSync(join(directory, 'binding.gyp'), 'utf8');
  assert.ok(binding.includes('"src/linux/InotifyBackend.cc"'));
  assert.ok(!binding.includes('WatchmanBackend'));
}

function buildBinding(directory, patch) {
  cd(directory);
  applyPatch(directory, patch);
  verifyBindingPatch(directory);
  run('npm', ['install', '--ignore-scripts']);
  const nodeDir = run('brew', ['--prefix'], { capture: true }).stdout.trim();
  run('npx', ['-y', 'node-gyp', 'rebuild', `--nodedir=${nodeDir}`]);
  assert.ok(existsSync(join(directory, 'build/Release/watcher.node')));
}

async function writeSnapshot(watcher, prefix) {
  const directory = mkdtempSync(join(tmpdir(), prefix));
  const snapshot = join(tmpdir(), `${prefix}snapshot.txt`);
  try {
    writeFileSync(join(directory, 'a.txt'), 'x');
    await watcher.writeSnapshot(directory, snapshot, {});
    assert.ok(existsSync(snapshot), 'snapshot file missing');
  } finally {
    rmSync(directory, { recursive: true, force: true });
    rmSync(snapshot, { force: true });
  }
}

export default class ParcelWatcher extends Port {
  static pkgname = 'parcel-watcher';
  static upstream = '@parcel/watcher';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [
    `@ohos-npm-ports/parcel-watcher-openharmony-arm64:slots/openharmony-arm64/parcel-watcher-openharmony-arm64-${version}`,
    `parcel-watcher-${version}`,
  ];
  static source = `https://registry.npmjs.org/@parcel/watcher/-/watcher-${version}.tgz`;
  static sha256 = 'ab42807be3df24a12d01e31568a7e61def1a4bee636a7c60a397319eff677e95';
  static resources = [
    resource(
      'upstream',
      `https://github.com/parcel-bundler/watcher/archive/refs/tags/v${version}.tar.gz`,
      'f211a58fd11297f187b4f2120ea60e4b637ce5c54492182944a8ee89bebcf747',
    ),
  ];

  build() {
    // Repack the official tgz with a source-built OpenHarmony binding at the
    // upstream fallback path. Other platforms keep using optionalDependencies.
    // The OpenHarmony alias also has a static wrapper reference for bun --compile.
    cd(rootDir);
    fetchResource('upstream', `watcher-${version}.tar.gz`);
    run('tar', ['-zxf', `watcher-${version}.tar.gz`]);
    rmSync(`watcher-${version}.tar.gz`);
    buildBinding(sourceDir, join(rootDir, 'patches/0001-binding-gyp-drop-watchman.patch'));

    cd(rootDir);
    fetchSource('watcher.tgz');
    run('tar', ['-zxf', 'watcher.tgz']);
    rmSync('watcher.tgz');
    renameSync('package', packageDir);
    copyFileSync(join(packageDir, 'index.js'), join(rootDir, 'index.js.upstream'));
    copyFileSync(join(packageDir, 'wrapper.js'), join(rootDir, 'wrapper.js.upstream'));
    applyPatch(packageDir, join(rootDir, 'patches/0002-package-json.patch'));
    applyPatch(packageDir, join(rootDir, 'patches/0003-wrapper-static-slot-ref.patch'));
    assert.ok(readFileSync(join(packageDir, 'wrapper.js'), 'utf8').includes("require('@parcel/watcher-openharmony-arm64')"));
    mkdirSync(join(packageDir, 'build/Release'), { recursive: true });
    copyFileSync(join(sourceDir, 'build/Release/watcher.node'), join(packageDir, 'build/Release/watcher.node'));

    assert.deepEqual(readFileSync(join(packageDir, 'index.js')), readFileSync(join(rootDir, 'index.js.upstream')));
    const wrapper = readFileSync(join(packageDir, 'wrapper.js'), 'utf8');
    const upstreamWrapper = readFileSync(join(rootDir, 'wrapper.js.upstream'), 'utf8');
    assert.equal(wrapper.split('\n').slice(6).join('\n'), upstreamWrapper);
    rmSync(join(rootDir, 'index.js.upstream'));
    rmSync(join(rootDir, 'wrapper.js.upstream'));

    const pkg = readJson(join(packageDir, 'package.json'));
    assert.equal(pkg.version, version);
    assert.equal(Object.keys(pkg.optionalDependencies ?? {}).length, 13);
    assert.equal(pkg.optionalDependencies['@parcel/watcher-linux-arm64-musl'], version);
    assert.equal(
      pkg.optionalDependencies['@parcel/watcher-openharmony-arm64'],
      `npm:@ohos-npm-ports/parcel-watcher-openharmony-arm64@${version}`,
    );
    assert.ok(!('install' in (pkg.scripts ?? {})));
    run(process.execPath, ['--check', join(packageDir, 'index.js')]);
    run(process.execPath, ['--check', join(packageDir, 'wrapper.js')]);
  }

  slot_openharmony_arm64_build() {
    // The slot main is a JS shim so bundlers register the package in their
    // module table; its literal watcher.node require loads the real binding.
    cd(slotDir);
    fetchResource('upstream', `watcher-${version}.tar.gz`);
    run('tar', ['-zxf', `watcher-${version}.tar.gz`]);
    rmSync(`watcher-${version}.tar.gz`);
    buildBinding(slotSourceDir, join(slotDir, 'patches/0001-binding-gyp-drop-watchman.patch'));

    mkdirSync(slotPackageDir);
    copyFileSync(join(slotSourceDir, 'build/Release/watcher.node'), join(slotPackageDir, 'watcher.node'));
    writeFileSync(join(slotPackageDir, 'index.js'), "module.exports = require('./watcher.node')\n");
    writeJson(join(slotPackageDir, 'package.json'), {
      version,
      description: 'OpenHarmony (OHOS) arm64 platform binding for @parcel/watcher — source-built inotify backend, main is a shim re-exporting watcher.node (bundler module-table embedding requires a JS entry)',
      main: 'index.js',
      license: 'MIT',
      files: ['index.js', 'watcher.node'],
      engines: { node: '>= 10.0.0' },
      os: ['openharmony'],
      cpu: ['arm64'],
    });

    const pkg = readJson(join(slotPackageDir, 'package.json'));
    assert.equal(pkg.version, version);
    assert.equal(pkg.main, 'index.js');
    assert.ok(readFileSync(join(slotPackageDir, 'index.js'), 'utf8').includes("require('./watcher.node')"));
    assert.ok(existsSync(join(slotPackageDir, 'watcher.node')));
    run(process.execPath, ['--check', join(slotPackageDir, 'index.js')]);
  }

  async test() {
    const watcher = requirePackage('@parcel/watcher');
    assert.equal(typeof watcher.writeSnapshot, 'function');
    if (process.platform === 'openharmony') {
      const slot = requirePackage('@parcel/watcher-openharmony-arm64');
      assert.equal(typeof slot.writeSnapshot, 'function');
    }
    await writeSnapshot(watcher, 'parcel-watcher-');
    return {
      result: { writeSnapshot: true },
      assets: [],
    };
  }
}
