#!/usr/bin/env node
import assert from 'node:assert/strict';
import { Port, run, cd, fetchSource, readJson, writeJson, requirePackage, recipeContext } from '../../../cli/recipe.mjs';
import { chmodSync, copyFileSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, join } from 'node:path';

const version = '7.0.0-dev.20260707.2';
const slotName = 'typescript-native-preview-openharmony-arm64';
const slotPackageName = `@ohos-npm-ports/${slotName}`;
const tsgoCommit = '9977d6d38fcc78de8ae71770f3aa08256e6cc861';
const rootDir = import.meta.dirname;
const buildDir = join(rootDir, 'build');
const packageDir = join(buildDir, `typescript-native-preview-${version}`);
const slotDir = join(buildDir, slotName);
const sourceDir = join(buildDir, 'typescript-go');

export default class TypescriptNativePreview extends Port {
  static pkgname = 'typescript-native-preview';
  static upstream = '@typescript/native-preview';
  static version = version;
  static revision = 4;
  static distTag = 'latest';
  static bump = false;
  static source = `https://registry.npmjs.org/@typescript/native-preview/-/native-preview-${version}.tgz`;
  static sha256 = '50cd22d1de46ec5f39ab27edf10d1b4ab35937eb1a6edcb171370f361b572289';
  static packages = [
    `@ohos-npm-ports/typescript-native-preview-openharmony-arm64:build/${slotName}`,
    `build/typescript-native-preview-${version}`,
  ];

  prepare() {
    run('brew', ['install', '-y', 'go']);
    process.env.GOTMPDIR = join(buildDir, '.gotmpdir');
    process.env.GOCACHE = join(buildDir, '.gocache');
    process.env.GOMODCACHE = join(buildDir, '.gomodcache');
    mkdirSync(process.env.GOTMPDIR, { recursive: true });
    mkdirSync(process.env.GOCACHE, { recursive: true });
    mkdirSync(process.env.GOMODCACHE, { recursive: true });
    rmSync(packageDir, { recursive: true, force: true });
    rmSync(slotDir, { recursive: true, force: true });
    rmSync(sourceDir, { recursive: true, force: true });
    mkdirSync(join(slotDir, 'lib'), { recursive: true });
    fetchSource(join(buildDir, 'native-preview.tgz'));
    run('tar', ['-zxf', join(buildDir, 'native-preview.tgz'), '-C', buildDir]);
    rmSync(join(buildDir, 'native-preview.tgz'), { force: true });
    renameSync(join(buildDir, 'package'), packageDir);
    run('git', ['init', '-q', sourceDir]);
    run('git', ['-C', sourceDir, 'remote', 'add', 'origin', 'https://github.com/microsoft/typescript-go.git']);
    run('git', ['-C', sourceDir, 'fetch', '--depth', '1', 'origin', tsgoCommit]);
    run('git', ['-C', sourceDir, 'checkout', '-q', 'FETCH_HEAD']);
  }

  build() {
    cd(sourceDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0003-skip-fanotify-on-hongmeng.patch')) });
    assert.ok(readFileSync(join(sourceDir, 'internal/fswatch/fanotify_linux.go'), 'utf8').includes('hongMengKernel'));
    run('go', ['build', '-ldflags=-s -w', '-trimpath', '-tags=noembed', '-o', join(slotDir, 'lib/tsgo'), './cmd/tsgo']);
    const libs = join(sourceDir, 'internal/bundled/libs');
    for (const file of readdirSync(libs)) {
      if (file.endsWith('.d.ts')) copyFileSync(join(libs, file), join(slotDir, 'lib', file));
    }
    assert.ok(statSync(join(slotDir, 'lib/tsgo')).size > 0);
    cd(packageDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0001-update-package-json.patch')) });
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0002-add-openharmony-support.patch')) });
    assert.ok(readFileSync(join(packageDir, 'lib/getExePath.js'), 'utf8').includes(slotPackageName));
  }

  package() {
    copyFileSync(join(packageDir, 'LICENSE'), join(slotDir, 'LICENSE'));
    copyFileSync(join(packageDir, 'NOTICE.txt'), join(slotDir, 'NOTICE.txt'));
    chmodSync(join(slotDir, 'lib/tsgo'), 0o755);
    writeJson(join(slotDir, 'package.json'), {
      version,
      description: 'OpenHarmony arm64 native tsgo binary for @ohos-npm-ports/typescript-native-preview',
      license: 'Apache-2.0',
      preferUnplugged: true,
      os: ['openharmony'],
      cpu: ['arm64'],
      files: ['lib', 'LICENSE', 'NOTICE.txt'],
    });
    const main = readJson(join(packageDir, 'package.json'));
    const slot = readJson(join(slotDir, 'package.json'));
    assert.equal(main.version, slot.version);
    const dependencies = Object.keys(main.optionalDependencies ?? {});
    assert.equal(dependencies.length, 8);
    assert.ok(dependencies.includes('@typescript/native-preview-linux-arm64'));
    assert.ok(dependencies.includes(slotPackageName));
    run(process.execPath, ['--check', join(packageDir, 'lib/getExePath.js')]);
    run(process.execPath, ['--check', join(packageDir, 'lib/tsgo.js')]);
    run(process.execPath, ['--check', join(packageDir, 'bin/tsgo')]);
  }

  static testTimeout = 600_000;

  test() {
    const context = recipeContext();
    const pkg = requirePackage('@typescript/native-preview/package.json');
    if (context.mode !== 'baseline') {
      assert.equal(pkg.name, '@ohos-npm-ports/typescript-native-preview');
      assert.equal(pkg.version, context.portVersion);
    }
    const cli = join(dirname(context.resolvePackage('@typescript/native-preview/package.json')), 'bin/tsgo');
    assert.ok(existsSync(cli));
    run(process.execPath, [cli, '--version']);
    const smokeDir = mkdtempSync(join(tmpdir(), 'typescript-native-preview-test-'));
    try {
      writeFileSync(join(smokeDir, 'tsconfig.json'), '{"compilerOptions":{"strict":true}}');
      writeFileSync(join(smokeDir, 'bad.ts'), 'const n: number = "x";\n');
      const result = run(process.execPath, [cli, '--noEmit', '-p', 'tsconfig.json'], {
        cwd: smokeDir,
        capture: true,
        allowExitCodes: [0, 1, 2],
      });
      assert.match(result.stdout + result.stderr, /error TS2322/);
      return { result: { cli: true, typecheckDiagnostic: 'TS2322' }, assets: [] };
    } finally {
      rmSync(smokeDir, { recursive: true, force: true });
    }
  }
}
