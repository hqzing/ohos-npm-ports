#!/usr/bin/env node
import assert from 'node:assert/strict';
import { chmodSync, existsSync, readFileSync, renameSync, rmSync } from 'node:fs';
import { join } from 'node:path';
import { Port, run, shell, cd, fetchSource, readJson, requirePackage } from '../../../cli/recipe.mjs';

const version = '4.3.3';
const rootDir = import.meta.dirname;
const sourceDir = join(rootDir, 'src');
const nodeDir = join(sourceDir, 'crates/node');

export default class TailwindcssOxide extends Port {
  static pkgname = 'tailwindcss-oxide';
  static upstream = '@tailwindcss/oxide';
  static version = version;
  static revision = 4;
  static distTag = 'latest';
  static packages = [
    '@ohos-npm-ports/tailwindcss-oxide-openharmony-arm64:src/crates/node/npm/openharmony-arm64',
    'src/crates/node',
  ];
  static source = `https://github.com/tailwindlabs/tailwindcss/archive/refs/tags/v${version}.tar.gz`;
  static sha256 = 'e702ce2493505287e8f6cab2dd1e0c14f154e57c296854d4ded38bde5da2be6e';

  build() {
    // This native napi-rs build produces the JS loader and a separate OHOS
    // binary package, mirroring upstream's per-platform package split. Other
    // platforms retain their real upstream optionalDependencies.
    const archive = join(rootDir, 'tailwindcss.tar.gz');
    fetchSource(archive);
    run('tar', ['-zxf', archive, '-C', rootDir]);
    rmSync(archive);
    rmSync(sourceDir, { recursive: true, force: true });
    renameSync(join(rootDir, `tailwindcss-${version}`), sourceDir);
    cd(sourceDir);

    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0001-package-json.patch')) });
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0002-add-openharmony-subpackage.patch')) });

    cd(nodeDir);
    run('npm', ['install', '--ignore-scripts']);

    // Prefer cargo's native linker override over napi-rs's cross-toolchain path.
    process.env.CARGO_TARGET_AARCH64_UNKNOWN_LINUX_OHOS_LINKER = shell('command -v cc', { capture: true }).stdout.trim();
    run('npm', ['run', 'build:platform']);

    // The generated loader otherwise looks for non-existent upstream OHOS packages.
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0003-fix-openharmony-loader-require.patch')) });
    assert.ok(
      readFileSync('index.js', 'utf8').includes("require('@ohos-npm-ports/tailwindcss-oxide-openharmony-arm64')"),
      'loader still references upstream @tailwindcss/oxide-openharmony-arm64',
    );

    const nodeFile = 'npm/openharmony-arm64/tailwindcss-oxide.openharmony-arm64.node';
    assert.ok(existsSync(nodeFile), `${nodeFile} is missing`);
    run('llvm-strip', ['--strip-all', nodeFile]);
    chmodSync(nodeFile, 0o755);

    const main = readJson('package.json');
    const sub = readJson('npm/openharmony-arm64/package.json');
    assert.equal(
      main.optionalDependencies['@ohos-npm-ports/tailwindcss-oxide-openharmony-arm64'],
      sub.version,
      'openharmony optionalDependency pin differs from the subpackage version',
    );
  }

  test() {
    const { Scanner } = requirePackage('@tailwindcss/oxide');
    const scanner = new Scanner({ sources: [] });
    const candidates = scanner.scanFiles([
      { content: '<div class="text-red-500 flex"></div>', extension: 'html' },
    ]);
    assert.ok(candidates.includes('text-red-500') && candidates.includes('flex'), `unexpected scan output: ${JSON.stringify(candidates)}`);
    return {
      result: {
        textRed500: candidates.includes('text-red-500'),
        flex: candidates.includes('flex'),
      },
      assets: [],
    };
  }
}
