#!/usr/bin/env node
import assert from 'node:assert/strict';
import { Port, resource, run, cd, fetchSource, fetchResource, writeJson, requirePackage, recipeContext } from '../../../cli/recipe.mjs';
import { chmodSync, copyFileSync, cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from 'node:fs';
import { homedir, tmpdir } from 'node:os';
import { dirname, join } from 'node:path';

const version = '2.11.10';
const ghosttyCommit = '5147c0a503cdeed7615cce245cdd815ed7a6b692';
const rustNightly = '2026-07-03';
const zigVersion = '0.17.0';
const rootDir = import.meta.dirname;
const sourceDir = join(rootDir, `turborepo-${version}`);
const packageDir = join(rootDir, `turbo-${version}`);

function cargoCrate(name) {
  const registry = join(homedir(), '.cargo/registry/src');
  for (const directory of readdirSync(registry).sort()) {
    const candidate = join(registry, directory, name);
    if (existsSync(candidate)) return candidate;
  }
  throw new Error(`Cargo crate not found: ${name}`);
}

function makeWritable(directory) {
  chmodSync(directory, statSync(directory).mode | 0o200);
  for (const entry of readdirSync(directory, { withFileTypes: true })) {
    const file = join(directory, entry.name);
    if (entry.isDirectory()) makeWritable(file);
    else chmodSync(file, statSync(file).mode | 0o200);
  }
}

export default class Turbo extends Port {
  static pkgname = 'turbo';
  static upstream = 'turbo';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static source = `https://codeload.github.com/vercel/turborepo/tar.gz/refs/tags/v${version}`;
  static sha256 = 'a9786d3236e75aa32aac690018e6282952f9ef252f541274798c181dc1550b64';
  static resources = [
    resource(
      'zig',
      `https://ziglang.org/download/${zigVersion}/zig-aarch64-linux-${zigVersion}.tar.xz`,
      '9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8',
    ),
    resource(
      'rust_nightly',
      `https://static.rust-lang.org/dist/${rustNightly}/rust-nightly-aarch64-unknown-linux-ohos.tar.gz`,
      '3191de904f37ab70d64fe7b125b7d0f77ed5f6570ca409582f6966d1672174d9',
    ),
    resource(
      'ghostty',
      `https://codeload.github.com/ghostty-org/ghostty/tar.gz/${ghosttyCommit}`,
      '71c5b5d2ad2a2351dba79725c428a3065b51addc533ca8ec88114f1a9cfa7b10',
    ),
  ];
  static packages = [`turbo-${version}`];

  prepare() {
    run('brew', ['install', '-y', 'protobuf', 'capnp', 'openssl@3', 'libxml2', 'zlib']);
    const zigDir = join(rootDir, `zig-aarch64-linux-${zigVersion}`);
    fetchResource('zig', join(rootDir, 'zig.tar.xz'));
    run('tar', ['-xJf', join(rootDir, 'zig.tar.xz')], { cwd: rootDir });
    rmSync(join(rootDir, 'zig.tar.xz'), { force: true });
    chmodSync(join(zigDir, 'zig'), 0o755);
    process.env.PATH = `${zigDir}:${process.env.PATH}`;
    process.env.ZIG_GLOBAL_CACHE_DIR = join(rootDir, 'zig-cache');

    fetchResource('rust_nightly', join(rootDir, 'rust-nightly.tar.gz'));
    const extractDir = join(rootDir, 'rust-nightly-extract');
    mkdirSync(extractDir, { recursive: true });
    run('tar', ['-zxf', join(rootDir, 'rust-nightly.tar.gz'), '-C', extractDir, '--strip-components=1']);
    rmSync(join(rootDir, 'rust-nightly.tar.gz'), { force: true });
    const rustHome = join(rootDir, 'rust-nightly');
    run('sh', [
      join(extractDir, 'install.sh'),
      `--prefix=${rustHome}`,
      '--disable-ldconfig',
      '--components=rustc,cargo,rust-std-aarch64-unknown-linux-ohos',
    ]);
    rmSync(extractDir, { recursive: true, force: true });
    process.env.PATH = `${join(rustHome, 'bin')}:${process.env.PATH}`;
    const openssl = run('brew', ['--prefix', 'openssl@3'], { capture: true }).stdout.trim();
    const libxml2 = run('brew', ['--prefix', 'libxml2'], { capture: true }).stdout.trim();
    const zlib = run('brew', ['--prefix', 'zlib'], { capture: true }).stdout.trim();
    const brewPrefix = run('brew', ['--prefix'], { capture: true }).stdout.trim();
    process.env.LD_LIBRARY_PATH = [join(openssl, 'lib'), join(libxml2, 'lib'), join(zlib, 'lib')].join(':');
    process.env.CARGO_HTTP_CAINFO = join(brewPrefix, 'etc/openssl@3/cert.pem');
    run('cargo', ['--version']);

    fetchSource(join(rootDir, 'turborepo.tar.gz'));
    mkdirSync(sourceDir, { recursive: true });
    run('tar', ['-zxf', join(rootDir, 'turborepo.tar.gz'), '-C', sourceDir, '--strip-components=1']);
    rmSync(join(rootDir, 'turborepo.tar.gz'), { force: true });
    fetchResource('ghostty', join(rootDir, 'ghostty.tar.gz'));
    const ghosttyDir = join(rootDir, 'ghostty-src');
    mkdirSync(ghosttyDir, { recursive: true });
    run('tar', ['-zxf', join(rootDir, 'ghostty.tar.gz'), '-C', ghosttyDir, '--strip-components=1']);
    rmSync(join(rootDir, 'ghostty.tar.gz'), { force: true });
    process.env.ghostty_source_dir = ghosttyDir;
  }

  build() {
    cd(sourceDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0002-openharmony-wrapper.patch')) });
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0005-libghostty-vt-sys-ohos-zig-target.patch')) });
    run('cargo', ['fetch']);
    mkdirSync(join(sourceDir, 'vendor'), { recursive: true });
    for (const name of ['nix', 'zstd-sys', 'aws-lc-sys']) rmSync(join(sourceDir, 'vendor', name), { recursive: true, force: true });
    cpSync(cargoCrate('nix-0.26.2'), join(sourceDir, 'vendor/nix'), { recursive: true });
    cpSync(cargoCrate('zstd-sys-2.0.16+zstd.1.5.7'), join(sourceDir, 'vendor/zstd-sys'), { recursive: true });
    cpSync(cargoCrate('aws-lc-sys-0.46.0'), join(sourceDir, 'vendor/aws-lc-sys'), { recursive: true });
    for (const name of ['nix', 'zstd-sys', 'aws-lc-sys']) makeWritable(join(sourceDir, 'vendor', name));
    run('patch', ['-p1'], { cwd: join(sourceDir, 'vendor/nix'), input: readFileSync(join(rootDir, 'patches/0006-nix-0.26.2-ohos.patch')) });
    run('patch', ['-p1'], { cwd: join(sourceDir, 'vendor/zstd-sys'), input: readFileSync(join(rootDir, 'patches/0007-zstd-sys-ohos-qsort.patch')) });
    run('patch', ['-p1'], { cwd: join(sourceDir, 'vendor/aws-lc-sys'), input: readFileSync(join(rootDir, 'patches/0008-aws-lc-sys-ohos-cc-builder.patch')) });
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0003-workspace-cargo-manifest.patch')) });
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0004-cargo-lock.patch')) });
    run('cargo', ['build', '--release', '--locked', '-p', 'turbo']);
    assert.ok(statSync(join(sourceDir, 'target/release/turbo')).size > 0);
  }

  package() {
    mkdirSync(join(packageDir, 'bin'), { recursive: true });
    for (const file of ['packages/turbo/package.json', 'packages/turbo/README.md', 'LICENSE']) {
      copyFileSync(join(sourceDir, file), join(packageDir, file.split('/').at(-1)));
    }
    copyFileSync(join(sourceDir, 'packages/turbo/bin/turbo'), join(packageDir, 'bin/turbo'));
    chmodSync(join(packageDir, 'bin/turbo'), 0o755);
    copyFileSync(join(sourceDir, 'packages/turbo-types/schemas/schema.json'), join(packageDir, 'schema.json'));
    run('llvm-strip', ['--strip-all', join(sourceDir, 'target/release/turbo'), '-o', join(packageDir, 'bin/turbo-linux-arm64')]);
    chmodSync(join(packageDir, 'bin/turbo-linux-arm64'), 0o755);
    const wrapper = readFileSync(join(packageDir, 'bin/turbo'), 'utf8');
    assert.ok(wrapper.includes('turbo-linux-arm64'));
    assert.ok(wrapper.includes('platform === "openharmony"'));
  }

  static testPlatforms = ['openharmony'];
  static testPlatformReason = 'This port ships only an OpenHarmony arm64 native binary.';
  static testTimeout = 600_000;

  test() {
    const context = recipeContext();
    const pkg = requirePackage('turbo/package.json');
    if (context.mode !== 'baseline') {
      assert.equal(pkg.name, '@ohos-npm-ports/turbo');
      assert.equal(pkg.version, context.portVersion);
    }
    const wrapper = join(dirname(context.resolvePackage('turbo/package.json')), 'bin/turbo');
    assert.equal(run(process.execPath, [wrapper, '--version'], { capture: true }).stdout.trim(), version);
    const smokeDir = mkdtempSync(join(tmpdir(), 'turbo-test-'));
    try {
      mkdirSync(join(smokeDir, 'packages/pkg-a'), { recursive: true });
      mkdirSync(join(smokeDir, 'packages/pkg-b'), { recursive: true });
      writeFileSync(join(smokeDir, 'package.json'), JSON.stringify({
        name: 'turbo-smoke',
        private: true,
        packageManager: 'npm@10.0.0',
        workspaces: ['packages/*'],
      }, null, 2));
      writeFileSync(join(smokeDir, 'turbo.json'), JSON.stringify({
        $schema: 'https://turborepo.dev/schema.json',
        tasks: { build: { outputs: ['dist/**'] } },
      }, null, 2));
      for (const name of ['pkg-a', 'pkg-b']) {
        const directory = join(smokeDir, 'packages', name);
        mkdirSync(join(directory, 'dist'), { recursive: true });
        writeFileSync(join(directory, 'dist/out.txt'), `built-by-${name}\n`);
        writeJson(join(directory, 'package.json'), {
          name,
          version: '0.0.0',
          private: true,
          scripts: { build: `mkdir -p dist && echo built-by-${name} > dist/out.txt` },
        });
      }
      const options = { cwd: smokeDir, env: { TURBO_TELEMETRY_DISABLED: '1' }, capture: true };
      run(process.execPath, [wrapper, 'run', 'build'], options);
      const executed = run(process.execPath, [wrapper, 'run', 'build'], options);
      assert.match(executed.stdout + executed.stderr, /cache miss, executing/);
      assert.equal(readFileSync(join(smokeDir, 'packages/pkg-a/dist/out.txt'), 'utf8').trim(), 'built-by-pkg-a');
      assert.equal(readFileSync(join(smokeDir, 'packages/pkg-b/dist/out.txt'), 'utf8').trim(), 'built-by-pkg-b');
      const cached = run(process.execPath, [wrapper, 'run', 'build'], options);
      assert.match(cached.stdout + cached.stderr, /FULL TURBO/);
      return { result: { version: true, build: true, fullCacheHit: true }, assets: [] };
    } finally {
      rmSync(smokeDir, { recursive: true, force: true });
    }
  }
}
