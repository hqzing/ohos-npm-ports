#!/usr/bin/env node
import assert from 'node:assert/strict';
import { Port, run, cd, fetchSource, readJson, writeJson, requirePackage, recipeContext } from '../../../cli/recipe.mjs';
import { copyFileSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, join } from 'node:path';

const version = '7.0.2';
const slotName = 'typescript-openharmony-arm64';
const rootDir = import.meta.dirname;
const buildDir = join(rootDir, 'build');
const sourceDir = join(buildDir, 'typescript-go');
const packageDir = join(buildDir, `typescript-${version}`);
const slotDir = join(buildDir, slotName);

export default class Typescript extends Port {
  static pkgname = 'typescript';
  static upstream = 'typescript';
  static version = version;
  static revision = 5;
  static distTag = 'latest';
  static source = `https://registry.npmjs.org/typescript/-/typescript-${version}.tgz`;
  static sha256 = 'da2513f4b95176d6dde8b51aab7afe8a927656c9d277369793f77f7e59371c08';
  static packages = [
    `@ohos-npm-ports/typescript-openharmony-arm64:build/${slotName}`,
    `build/typescript-${version}`,
  ];

  prepare() {
    mkdirSync('/data/storage/el2/base/cache', { recursive: true });
    mkdirSync('/data/storage/el2/base/file', { recursive: true });
    run('brew', ['install', '-y', 'go']);
    rmSync(buildDir, { recursive: true, force: true });
    mkdirSync(buildDir, { recursive: true });
    fetchSource(join(buildDir, `typescript-${version}.tgz`));
    run('tar', ['-zxf', join(buildDir, `typescript-${version}.tgz`), '-C', buildDir]);
    renameSync(join(buildDir, 'package'), packageDir);
    run('git', ['clone', '--depth', '1', '--branch', `typescript/v${version}`, 'https://github.com/microsoft/typescript-go.git', sourceDir]);
    run('patch', ['-p1'], { cwd: sourceDir, input: readFileSync(join(rootDir, 'patches/0003-skip-fanotify-on-hongmeng.patch')) });
  }

  build() {
    mkdirSync(join(slotDir, 'lib'), { recursive: true });
    cd(sourceDir);
    run('go', ['build', '-ldflags=-s -w', '-trimpath', '-tags=noembed', '-o', join(slotDir, 'lib/tsc'), './cmd/tsgo']);
    const libs = join(sourceDir, 'internal/bundled/libs');
    for (const file of readdirSync(libs)) {
      if (file.endsWith('.d.ts')) copyFileSync(join(libs, file), join(slotDir, 'lib', file));
    }
    run(join(slotDir, 'lib/tsc'), ['--version']);
    assert.ok(statSync(join(slotDir, 'lib/lib.d.ts')).size > 0);
  }

  package() {
    cd(packageDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0001-update-package-json.patch')) });
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0002-add-openharmony-support.patch')) });
    copyFileSync(join(packageDir, 'LICENSE'), join(slotDir, 'LICENSE'));
    copyFileSync(join(packageDir, 'NOTICE.txt'), join(slotDir, 'NOTICE.txt'));
    writeJson(join(slotDir, 'package.json'), {
      version,
      description: 'OpenHarmony arm64 native tsgo binary for @ohos-npm-ports/typescript',
      license: 'Apache-2.0',
      preferUnplugged: true,
      os: ['openharmony'],
      cpu: ['arm64'],
      files: ['lib', 'LICENSE', 'NOTICE.txt'],
    });
    const main = readJson(join(packageDir, 'package.json'));
    const slot = readJson(join(slotDir, 'package.json'));
    assert.equal(main.version, slot.version);
    assert.equal(main.optionalDependencies['@ohos-npm-ports/typescript-openharmony-arm64'], slot.version);
    assert.ok(readFileSync(join(packageDir, 'lib/getExePath.js'), 'utf8').includes('@ohos-npm-ports/typescript-openharmony-arm64'));
  }

  static testTimeout = 600_000;

  test() {
    const context = recipeContext();
    const pkg = requirePackage('typescript/package.json');
    if (context.mode !== 'baseline') {
      assert.equal(pkg.name, '@ohos-npm-ports/typescript');
      assert.equal(pkg.version, context.portVersion);
    }
    const cli = join(dirname(context.resolvePackage('typescript/package.json')), 'bin/tsc');
    assert.ok(existsSync(cli));
    run(process.execPath, [cli, '--version']);
    const smokeDir = mkdtempSync(join(tmpdir(), 'typescript-test-'));
    try {
      writeFileSync(join(smokeDir, 'tsconfig.json'), '{"compilerOptions":{"strict":true}}');
      writeFileSync(join(smokeDir, 'bad.ts'), 'const n: number = "x";\n');
      const result = run(process.execPath, [cli, '--noEmit', '-p', 'tsconfig.json'], {
        cwd: smokeDir,
        capture: true,
        allowExitCodes: [0, 1, 2],
      });
      assert.match(result.stdout + result.stderr, /error TS/);
      return { result: { cli: true, typecheckDiagnostic: true }, assets: [] };
    } finally {
      rmSync(smokeDir, { recursive: true, force: true });
    }
  }
}
