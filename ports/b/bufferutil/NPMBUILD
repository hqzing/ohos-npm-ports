#!/usr/bin/env node
import { Port, resource, run, cd, fetchSource, fetchResource } from '../../../cli/recipe.mjs';
import { existsSync, readFileSync, renameSync, rmSync } from 'node:fs';

const version = '4.1.0';

export default class Bufferutil extends Port {
  static pkgname = 'bufferutil';
  static upstream = 'bufferutil';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [`bufferutil-${version}`];
  static source = `https://github.com/websockets/bufferutil/archive/refs/tags/v${version}.tar.gz`;
  static sha256 = '42971057cdc3acb64422aca071146d9d5bf73a42a142519d72db51896b0b0972';
  static resources = [
    resource(
      'npm',
      `https://registry.npmjs.org/bufferutil/-/bufferutil-${version}.tgz`,
      '19af5978088739b8baf861a95ab4a1feb69a2d30830ced707c37920591046a87',
    ),
  ];

  build() {
    fetchSource(`bufferutil-${version}.tar.gz`);
    run('tar', ['-zxf', `bufferutil-${version}.tar.gz`]);

    cd(`bufferutil-${version}`);
    run('patch', ['-p1'], { input: readFileSync('../patches/0001-update-package-json.patch') });
    run('npm', ['install']);
    run('npm', ['run', 'prebuild']);

    cd('..');
    fetchResource('npm', `bufferutil-${version}.tgz`);
    run('tar', ['-zxf', `bufferutil-${version}.tgz`]);
    rmSync(`bufferutil-${version}.tgz`);
    run('cp', ['-r', 'package/prebuilds/.', `bufferutil-${version}/prebuilds/`]);

    renameSync(
      `bufferutil-${version}/prebuilds/linux-x64/bufferutil.node`,
      `bufferutil-${version}/prebuilds/linux-x64/@ohos-npm-ports+bufferutil.node`,
    );
    renameSync(
      `bufferutil-${version}/prebuilds/win32-ia32/bufferutil.node`,
      `bufferutil-${version}/prebuilds/win32-ia32/@ohos-npm-ports+bufferutil.node`,
    );
    renameSync(
      `bufferutil-${version}/prebuilds/win32-x64/bufferutil.node`,
      `bufferutil-${version}/prebuilds/win32-x64/@ohos-npm-ports+bufferutil.node`,
    );
    for (const platform of ['darwin-x64', 'darwin-arm64', 'darwin-x64+arm64']) {
      if (existsSync(`bufferutil-${version}/prebuilds/${platform}`)) {
        renameSync(
          `bufferutil-${version}/prebuilds/${platform}/bufferutil.node`,
          `bufferutil-${version}/prebuilds/${platform}/@ohos-npm-ports+bufferutil.node`,
        );
      }
    }
  }
}
