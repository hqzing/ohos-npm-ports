#!/usr/bin/env node
import assert from 'node:assert/strict';
import { Port, resource, run, cd, fetchSource, fetchResource, readJson } from '../../../cli/recipe.mjs';
import { chmodSync, cpSync, mkdirSync, readFileSync, renameSync, rmSync, statSync } from 'node:fs';
import { join } from 'node:path';

const version = '5.20.0';
const rootDir = import.meta.dirname;
const packageDir = join(rootDir, `datadog-pprof-${version}`);

export default class DatadogPprof extends Port {
  static pkgname = 'datadog-pprof';
  static upstream = '@datadog/pprof';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [`datadog-pprof-${version}`];
  static source = `https://github.com/DataDog/pprof-nodejs/archive/refs/tags/v${version}.tar.gz`;
  static sha256 = 'a9795e81d5b8db306cfb4b5564ff98942f427495098a190ebb89097a0551657d';
  static resources = [
    resource(
      'npm',
      `https://registry.npmjs.org/@datadog/pprof/-/pprof-${version}.tgz`,
      '62509b7b9e529961322d32be9525a4c41345b34f4119c7720a5680c3e2737632',
    ),
  ];

  build() {
    cd(rootDir);
    fetchSource('pprof.tar.gz');
    run('tar', ['-zxf', 'pprof.tar.gz']);
    rmSync('pprof.tar.gz');
    renameSync(`pprof-nodejs-${version}`, packageDir);

    cd(packageDir);
    run('patch', ['-p1'], { input: readFileSync('../patches/0001-update-package-json.patch') });
    run('npm', ['install', '--ignore-scripts']);
    run('npm', ['install', '--ignore-scripts', '--no-save', 'node-gyp']);
    process.env.PATH = `${process.cwd()}/node_modules/.bin:${process.env.PATH}`;

    run('npm', ['run', 'compile']);
    try {
      run('brew', ['unlink', 'ohos-sdk']);
    } catch {}
    run('brew', ['install', '-y', 'llvm@22', 'lld@22']);
    const brewPrefix = run('brew', ['--prefix'], { capture: true }).stdout.trim();
    const llvmBin = join(brewPrefix, 'opt/llvm@22/bin');
    process.env.CC = join(llvmBin, 'clang');
    process.env.CXX = join(llvmBin, 'clang++');
    process.env.PATH = `${llvmBin}:${join(brewPrefix, 'opt/lld@22/bin')}:${process.env.PATH}`;
    run('node-gyp', ['rebuild', '--jobs=max']);

    const nodeAbi = run('node', ['-p', 'process.versions.modules'], { capture: true }).stdout.trim();
    assert.equal(nodeAbi, '147', `unexpected ABI ${nodeAbi} (expected 147)`);
    const prebuildName = `dd_pprof.node.abi${nodeAbi}.node`;
    mkdirSync('prebuilds/openharmony-arm64', { recursive: true });
    cpSync('build/Release/dd_pprof.node', `prebuilds/openharmony-arm64/${prebuildName}`);

    cd('prebuilds/openharmony-arm64');
    run('llvm-strip', ['--strip-all', prebuildName]);
    chmodSync(prebuildName, statSync(prebuildName).mode | 0o111);
    cd(packageDir);

    fetchResource('npm', 'official.tgz');
    run('tar', ['-zxf', 'official.tgz']);
    for (const platform of ['darwin-arm64', 'darwin-x64', 'linux-arm64', 'linux-x64', 'win32-x64']) {
      cpSync(join('package/prebuilds', platform), join('prebuilds', platform), { recursive: true });
    }
    rmSync('package', { recursive: true, force: true });
    rmSync('official.tgz');
    rmSync('build', { recursive: true, force: true });

    assert.equal(readJson('package.json').postinstall || '', '');
    const resolvedPath = run('node', ['-e', "console.log(require('./node_modules/node-gyp-build').resolve('.'))"], { capture: true }).stdout.trim();
    assert.ok(
      resolvedPath.endsWith(`/prebuilds/openharmony-arm64/${prebuildName}`),
      `node-gyp-build resolved to unexpected path: ${resolvedPath}`,
    );

    const nodeBin = join(brewPrefix, 'opt/node/bin/node');
    run(nodeBin, ['--version']);
    run(nodeBin, ['-e', `
      const { time } = require('./out/src/index.js');

      function hotLoop() {
        const start = Date.now();
        let acc = 0;
        while (Date.now() - start < 300) {
          for (let i = 0; i < 1000; i++) acc += Math.sqrt(i);
        }
        return acc;
      }

      time.start({ intervalMicros: 1000, durationMillis: 60000 });
      hotLoop();
      const profile = time.stop();

      const strings = profile.stringTable.strings;
      const summary = {
        sampleCount: profile.sample.length,
        locationCount: profile.location.length,
        functionCount: profile.function.length,
        hasHotLoop: strings.includes('hotLoop'),
      };
      console.log('TimeProfiler summary:', JSON.stringify(summary));
      if (summary.sampleCount === 0 || !summary.hasHotLoop) {
        throw new Error('smoke test failed: no samples or missing hotLoop frame');
      }
    `]);
  }
}
