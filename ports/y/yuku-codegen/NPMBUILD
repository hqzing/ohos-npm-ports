#!/usr/bin/env node
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { Port, run, cd, fetchSource, readJson, writeJson, importPackage } from '../../../cli/recipe.mjs';
import { cpSync, existsSync, mkdirSync, readdirSync, readFileSync, renameSync, rmSync, statSync } from 'node:fs';
import { join } from 'node:path';

const version = '0.19.0';
const rootDir = import.meta.dirname;
const stageDir = join(rootDir, 'build');
const sourceDir = join(stageDir, 'src');
const outputDir = join(rootDir, `yuku-codegen-${version}`);

function hashTree(directory) {
  const hashes = {};
  function walk(current, prefix = '') {
    for (const entry of readdirSync(current, { withFileTypes: true })) {
      const name = prefix + entry.name;
      const file = join(current, entry.name);
      if (entry.isDirectory()) walk(file, `${name}/`);
      else if (entry.isFile()) hashes[name] = createHash('sha256').update(readFileSync(file)).digest('hex');
    }
  }
  walk(directory);
  return Object.fromEntries(Object.entries(hashes).sort((left, right) => left[0].localeCompare(right[0])));
}

export default class YukuCodegen extends Port {
  static pkgname = 'yuku-codegen';
  static upstream = 'yuku-codegen';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static source = `https://registry.npmjs.org/yuku-codegen/-/yuku-codegen-${version}.tgz`;
  static sha256 = 'c836e4666aa8db2c64f87c433d26cf14d35ce3c02061722bc9b4e4770e7f2491';
  static packages = [`yuku-codegen-${version}`];

  prepare() {
    rmSync(stageDir, { recursive: true, force: true });
    mkdirSync(stageDir, { recursive: true });
    cd(stageDir);
    fetchSource(join(stageDir, 'src.tgz'));
    run('tar', ['-zxf', join(stageDir, 'src.tgz'), '-C', stageDir]);
    rmSync(join(stageDir, 'src.tgz'), { force: true });
    renameSync(join(stageDir, 'package'), sourceDir);
  }

  build() {
    cd(sourceDir);
    writeJson(join(stageDir, 'before-hashes.json'), hashTree(sourceDir));
    assert.equal(readJson(join(sourceDir, 'package.json')).version, version);
    assert.ok(statSync(join(sourceDir, 'dist/index.js')).size > 0);
    assert.ok(statSync(join(sourceDir, 'dist/index.d.ts')).size > 0);
    run(process.execPath, ['--check', join(sourceDir, 'dist/index.js')]);
  }

  package() {
    rmSync(outputDir, { recursive: true, force: true });
    cpSync(sourceDir, outputDir, { recursive: true });
    const pkg = readJson(join(outputDir, 'package.json'));
    assert.equal(pkg.version, version);
    assert.equal(pkg.main, './dist/index.js');
    assert.ok(!pkg.optionalDependencies);
    assert.ok(!pkg.dependencies?.['@yuku-codegen/binding-openharmony-arm64']);
    rmSync(join(outputDir, 'package.json.orig'), { force: true });
    const before = readJson(join(stageDir, 'before-hashes.json'));
    const after = hashTree(outputDir);
    const beforeFiles = Object.fromEntries(Object.entries(before).filter(entry => entry[0] !== 'package.json'));
    const afterFiles = Object.fromEntries(Object.entries(after).filter(entry => entry[0] !== 'package.json'));
    assert.deepEqual(afterFiles, beforeFiles);
    rmSync(stageDir, { recursive: true, force: true });
    assert.ok(existsSync(outputDir));
  }

  static testTimeout = 600_000;

  async test() {
    const { generate } = await importPackage('yuku-codegen');
    const ast = {
      type: 'Program',
      sourceType: 'module',
      start: 0,
      end: 6,
      body: [{
        type: 'ExpressionStatement',
        start: 0,
        end: 6,
        expression: {
          type: 'BinaryExpression',
          operator: '+',
          start: 0,
          end: 5,
          left: { type: 'Literal', value: 1, start: 0, end: 1 },
          right: { type: 'Literal', value: 2, start: 4, end: 5 },
        },
      }],
    };
    const pretty = generate(ast);
    assert.equal(pretty.code, '1 + 2;');
    assert.deepEqual(pretty.diagnostics, []);
    assert.equal(pretty.map, null);
    const compact = generate(ast, { minify: true });
    assert.equal(compact.code, '1+2');
    const mapped = generate(ast, { sourceMap: { source: '1 + 2;', file: 'out.js', sourceFileName: 'in.js' } });
    assert.equal(mapped.code, '1 + 2;');
    assert.equal(mapped.map.version, 3);
    assert.equal(mapped.map.file, 'out.js');
    assert.deepEqual(mapped.map.sources, ['in.js']);
    assert.ok(mapped.map.mappings.length > 0);
    return { result: { format: true, minify: true, sourceMap: true }, assets: [] };
  }
}
