#!/usr/bin/env node
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { Port, resource, run, cd, fetchSource, fetchResource, readJson, writeJson, importPackage } from '../../../cli/recipe.mjs';
import { copyFileSync, cpSync, existsSync, mkdirSync, readdirSync, readFileSync, renameSync, rmSync, statSync } from 'node:fs';
import { join } from 'node:path';

const version = '0.19.0';
const slotName = '@yuku-core/binding-openharmony-arm64';
const zigVersion = '0.17.0';
const rootDir = import.meta.dirname;
const stageDir = join(rootDir, 'build');
const sourceDir = join(stageDir, 'src');
const outputDir = join(rootDir, `yuku-parser-${version}`);

function hashTree(directory) {
  const hashes = {};
  function walk(current, prefix = '') {
    for (const entry of readdirSync(current, { withFileTypes: true })) {
      const name = prefix + entry.name;
      const file = join(current, entry.name);
      if (entry.isDirectory()) walk(file, `${name}/`);
      else if (entry.isFile()) hashes[name] = createHash('sha256').update(readFileSync(file)).digest('hex');
    }
  }
  walk(directory);
  return Object.fromEntries(Object.entries(hashes).sort((left, right) => left[0].localeCompare(right[0])));
}

export default class YukuParser extends Port {
  static pkgname = 'yuku-parser';
  static upstream = 'yuku-parser';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static source = `https://registry.npmjs.org/yuku-parser/-/yuku-parser-${version}.tgz`;
  static sha256 = '3655d771568e9e326a99ff5e43a6e72d4150f8098125c125e9e05d20c13172e5';
  static resources = [
    resource(
      'yuku',
      `https://github.com/yuku-toolchain/yuku/archive/refs/tags/v${version}.tar.gz`,
      '81f8015d458307f537865259604ee1ac6e169850ac6c280f4406387285ee613b',
    ),
    resource(
      'zig',
      `https://ziglang.org/download/${zigVersion}/zig-aarch64-linux-${zigVersion}.tar.xz`,
      '9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8',
    ),
  ];
  static packages = [`yuku-parser-${version}`];

  prepare() {
    rmSync(stageDir, { recursive: true, force: true });
    mkdirSync(stageDir, { recursive: true });
    cd(stageDir);
    fetchSource(join(stageDir, 'src.tgz'));
    run('tar', ['-zxf', join(stageDir, 'src.tgz'), '-C', stageDir]);
    rmSync(join(stageDir, 'src.tgz'), { force: true });
    renameSync(join(stageDir, 'package'), sourceDir);
    fetchResource('yuku', join(stageDir, 'yuku.tgz'));
    run('tar', ['-zxf', join(stageDir, 'yuku.tgz'), '-C', stageDir]);
    rmSync(join(stageDir, 'yuku.tgz'), { force: true });
    renameSync(join(stageDir, `yuku-${version}`), join(stageDir, 'yuku'));
    fetchResource('zig', join(stageDir, 'zig.tar.xz'));
    run('tar', ['-xJf', join(stageDir, 'zig.tar.xz'), '-C', stageDir]);
    rmSync(join(stageDir, 'zig.tar.xz'), { force: true });
  }

  build() {
    cd(sourceDir);
    writeJson(join(stageDir, 'before-hashes.json'), hashTree(sourceDir));
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0001-update-package-json.patch')) });
    const manifest = readFileSync(join(sourceDir, 'package.json'), 'utf8');
    assert.ok(manifest.includes(`"version": "${version}"`));
    assert.ok(manifest.includes('"bundledDependencies"'));
    assert.ok(manifest.includes('"yuku-core"'));
    const yukuDir = join(stageDir, 'yuku');
    cd(yukuDir);
    run(join(stageDir, `zig-aarch64-linux-${zigVersion}/zig`), ['build', '-Dtarget=aarch64-linux-musl', '-Doptimize=ReleaseFast']);
    assert.ok(statSync(join(yukuDir, 'zig-out/lib/yuku-core.node')).size > 0);
    copyFileSync(join(yukuDir, 'zig-out/lib/yuku-core.node'), join(stageDir, 'yuku-core.node'));
  }

  package() {
    rmSync(outputDir, { recursive: true, force: true });
    cpSync(sourceDir, outputDir, { recursive: true });
    const coreDir = join(outputDir, 'node_modules/yuku-core');
    mkdirSync(coreDir, { recursive: true });
    for (const file of ['index.js', 'index.d.ts', 'binding.js', 'browser.js', 'options.js', 'README.md']) {
      copyFileSync(join(stageDir, 'yuku/npm/yuku-core', file), join(coreDir, file));
    }
    const core = readJson(join(stageDir, 'yuku/npm/yuku-core/package.json'));
    core.version = version;
    core.dependencies = { '@yuku-toolchain/types': `^${core.version}` };
    delete core.optionalDependencies;
    core.repository = {
      type: 'git',
      url: 'git+https://github.com/ohos-npm-ports/ohos-npm-ports.git',
      directory: 'ports/y/yuku-parser',
    };
    core.files = [...core.files, slotName];
    writeJson(join(coreDir, 'package.json'), core);
    mkdirSync(join(coreDir, slotName), { recursive: true });
    copyFileSync(join(stageDir, 'yuku-core.node'), join(coreDir, slotName, 'yuku-core.node'));
    rmSync(join(outputDir, 'package.json.orig'), { force: true });
    const pkg = readJson(join(outputDir, 'package.json'));
    assert.equal(pkg.version, version);
    assert.ok(pkg.bundledDependencies?.includes('yuku-core'));
    const bundledCore = readJson(join(coreDir, 'package.json'));
    assert.equal(bundledCore.name, 'yuku-core');
    assert.equal(bundledCore.version, pkg.version);
    assert.ok(bundledCore.files?.includes(slotName));
    assert.ok(!bundledCore.optionalDependencies);
    const before = readJson(join(stageDir, 'before-hashes.json'));
    const after = hashTree(outputDir);
    const beforeFiles = Object.fromEntries(Object.entries(before).filter(entry => entry[0] !== 'package.json'));
    const afterFiles = Object.fromEntries(Object.entries(after).filter(entry => entry[0] !== 'package.json' && !entry[0].startsWith('node_modules/')));
    assert.deepEqual(afterFiles, beforeFiles);
    rmSync(stageDir, { recursive: true, force: true });
    assert.ok(existsSync(outputDir));
  }

  static testPlatforms = ['openharmony'];
  static testPlatformReason = 'The bundled native binding in this port supports only OpenHarmony arm64.';
  static testTimeout = 600_000;

  async test() {
    const api = await importPackage('yuku-parser');
    const result = api.parse('const answer: number = 40 + 2;', { path: 'sample.ts' });
    const declaration = result.program?.body?.[0];
    assert.equal(result.program?.type, 'Program');
    assert.equal(declaration?.type, 'VariableDeclaration');
    assert.equal(declaration.kind, 'const');
    assert.equal(result.diagnostics.length, 0);
    assert.notEqual(api.TokenKind.Const, undefined);
    return { result: { parse: true, diagnostics: true, tokenKind: true }, assets: [] };
  }
}
