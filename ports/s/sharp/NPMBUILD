#!/usr/bin/env node
import assert from 'node:assert/strict';
import { cpSync, existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { Port, resource, run, cd, fetchSource, fetchResource, readJson, requirePackage } from '../../../cli/recipe.mjs';

const version = '0.35.5';
const vipsVersion = '8.18.7';
const rootDir = import.meta.dirname;
const vipsSourceDir = join(rootDir, `vips-${vipsVersion}`);
const vipsInstallDir = join(rootDir, 'vips-install');
const sharpSourceDir = join(rootDir, 'sharp-src');
const packageDir = join(rootDir, 'pkg');
const upstreamAddon = `sharp-openharmony-arm64-${version}.node`;
const addon = 'sharp-openharmony-arm64.node';

export default class Sharp extends Port {
  static pkgname = 'sharp';
  static upstream = 'sharp';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = ['pkg'];
  static source = `https://registry.npmjs.org/sharp/-/sharp-${version}.tgz`;
  static sha256 = '3b6bbbe6b308f5c383938ca4a31926cd5d79c4651ed8c5fda16a97da2014a9ac';
  static resources = [
    resource(
      'vips',
      `https://github.com/libvips/libvips/releases/download/v${vipsVersion}/vips-${vipsVersion}.tar.xz`,
      '5baaead3b0bb20ffdb9e9ff09aa9fda08620923df77b63b436654cb5e0b3bf94',
    ),
  ];

  build() {
    // Build libvips and sharp natively for OHOS. Only the two libraries built
    // here are bundled; the codec/rendering dependency chain remains in the
    // Harmonybrew prefix and is found through the packaged RPATHs.
    run('brew', [
      'install', '-y', 'patchelf',
      'jpeg-turbo', 'libpng', 'webp', 'libtiff', 'giflib', 'glib', 'little-cms2', 'highway', 'cgif',
      'meson', 'pkgconf', 'exiv2', 'libarchive', 'libheif', 'libde265', 'libspng', 'librsvg', 'cairo',
      'pango', 'freetype', 'fontconfig', 'libimagequant', 'openjpeg', 'aom', 'dav1d', 'orc', 'gettext',
    ]);
    const brewPrefix = run('brew', ['--prefix'], { capture: true }).stdout.trim();
    process.env.PATH = `${brewPrefix}/bin:${process.env.PATH}`;
    process.env.LIBRARY_PATH = `${brewPrefix}/lib`;

    const vipsArchive = join(rootDir, 'vips.tar.xz');
    fetchResource('vips', vipsArchive);
    run('tar', ['-xf', vipsArchive, '-C', rootDir]);
    rmSync(vipsArchive);
    cd(vipsSourceDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0001-libvips-disable-nls-and-tools-build.patch')) });

    // Force JPEG 2000 support and keep heif linked into libvips rather than in
    // a dynamic module with build-tree-only lookup paths.
    run('meson', [
      'setup', 'build', `--prefix=${vipsInstallDir}`,
      '-Dopenjpeg=enabled', '-Dheif-module=disabled', '-Dexamples=false',
    ]);
    run('ninja', ['-C', 'build']);
    run('ninja', ['-C', 'build', 'install']);
    assert.match(
      readFileSync('build/meson-logs/meson-log.txt', 'utf8'),
      /JPEG2000 load\/save with libopenjp2.*YES/,
      'openjpeg/jp2 support did not get enabled',
    );

    const sharpArchive = join(rootDir, 'sharp.tgz');
    fetchSource(sharpArchive);
    mkdirSync(sharpSourceDir);
    run('tar', ['-xzf', sharpArchive, '-C', sharpSourceDir, '--strip-components=1']);
    rmSync(sharpArchive);
    cd(sharpSourceDir);
    process.env.PKG_CONFIG_PATH = join(vipsInstallDir, 'lib/pkgconfig');
    process.env.SHARP_FORCE_GLOBAL_LIBVIPS = '1';
    run('npm', ['install']);
    run('npm', ['run', 'build']);
    assert.ok(existsSync(join('src/build/Release', upstreamAddon)), `${upstreamAddon} is missing`);
  }

  package() {
    const brewPrefix = run('brew', ['--prefix'], { capture: true }).stdout.trim();
    rmSync(packageDir, { recursive: true, force: true });
    mkdirSync(join(packageDir, 'vendor'), { recursive: true });
    mkdirSync(join(packageDir, 'src/build/Release'), { recursive: true });
    cpSync(join(sharpSourceDir, 'dist'), join(packageDir, 'dist'), { recursive: true });
    const loaderFile = join(packageDir, 'dist/sharp.cjs');
    const loader = readFileSync(loaderFile, 'utf8');
    const updatedLoader = loader.replace('sharp-${runtimePlatform}-${version}.node', 'sharp-${runtimePlatform}.node');
    assert.notEqual(updatedLoader, loader, 'versioned addon require was not found in dist/sharp.cjs');
    writeFileSync(loaderFile, updatedLoader);
    cpSync(join(sharpSourceDir, 'lib'), join(packageDir, 'lib'), { recursive: true });
    cpSync(join(sharpSourceDir, 'package.json'), join(packageDir, 'package.json'));
    run('patch', ['-p1'], {
      cwd: packageDir,
      input: readFileSync(join(rootDir, 'patches/0002-package-json.patch')),
    });
    cpSync(join(sharpSourceDir, 'src/build/Release', upstreamAddon), join(packageDir, 'src/build/Release', addon));

    // Ship bare SONAME files rather than symlinks, which npm pack and file:
    // installs do not preserve reliably.
    cpSync(join(vipsInstallDir, 'lib/libvips.so.42.20.7'), join(packageDir, 'vendor/libvips.so.42'));
    cpSync(join(vipsInstallDir, 'lib/libvips-cpp.so.42.20.7'), join(packageDir, 'vendor/libvips-cpp.so.42'));
    run('llvm-strip', ['--strip-all', join(packageDir, 'src/build/Release', addon)]);
    run('llvm-strip', ['--strip-all', join(packageDir, 'vendor/libvips-cpp.so.42')]);
    run('llvm-strip', ['--strip-all', join(packageDir, 'vendor/libvips.so.42')]);

    run('patchelf', ['--set-rpath', `$ORIGIN/../../../vendor:${brewPrefix}/lib`, join(packageDir, 'src/build/Release', addon)]);
    run('patchelf', ['--set-rpath', `$ORIGIN:${brewPrefix}/lib`, join(packageDir, 'vendor/libvips-cpp.so.42')]);
    run('patchelf', ['--set-rpath', `$ORIGIN:${brewPrefix}/lib`, join(packageDir, 'vendor/libvips.so.42')]);

    const pkg = readJson(join(packageDir, 'package.json'));
    assert.equal(Object.keys(pkg.optionalDependencies ?? {}).length, 25, 'upstream platform optionalDependencies changed');
    assert.equal(pkg.optionalDependencies['@img/sharp-linux-arm64'], version, 'sharp platform subpackage version drifted');
    assert.equal(pkg.optionalDependencies['@img/sharp-libvips-linuxmusl-arm64'], '1.3.4', 'libvips platform subpackage version drifted');
  }

  static testPlatforms = ['openharmony'];
  static testPlatformReason = 'JP2 and AVIF validation requires the native OpenHarmony libvips build.';

  testSetup() {
    if (process.platform !== 'openharmony') return;
    run('brew', [
      'install', '-y', 'patchelf',
      'jpeg-turbo', 'libpng', 'webp', 'libtiff', 'giflib', 'glib', 'little-cms2', 'highway', 'cgif',
      'exiv2', 'libarchive', 'libheif', 'libde265', 'libspng', 'librsvg', 'cairo',
      'pango', 'freetype', 'fontconfig', 'libimagequant', 'openjpeg', 'aom', 'dav1d', 'orc', 'gettext',
    ]);
  }

  async test() {
    if (process.platform === 'openharmony') process.env.OPENSSL_CONF = '/dev/null';
    const sharp = requirePackage('sharp');
    const png = await sharp({
      create: { width: 40, height: 30, channels: 3, background: { r: 5, g: 200, b: 40 } },
    }).png().toBuffer();

    const { recipeContext } = await import('../../../cli/recipe.mjs');
    const { mode } = recipeContext();
    let back = { info: { width: 40, height: 30 } };
    if (mode !== 'baseline') {
      const jp2 = await sharp(png).jp2().toBuffer();
      back = await sharp(jp2).raw().toBuffer({ resolveWithObject: true });
      assert.equal(back.info.width, 40);
      assert.equal(back.info.height, 30);
      assert.ok(sharp.format.jp2?.output, `format.jp2 missing or incomplete: ${JSON.stringify(sharp.format.jp2)}`);
    }

    const avif = await sharp(png).avif().toBuffer();
    assert.ok(avif.length > 0, 'avif encode produced no bytes');
    return {
      result: { width: back.info.width, height: back.info.height, jp2: true, avif: true },
      assets: [],
    };
  }
}
