#!/usr/bin/env node
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { chmodSync, cpSync, mkdirSync, readFileSync, readdirSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs';
import { basename, join, relative, sep } from 'node:path';
import { Port, run, cd, fetchSource, readJson, writeJson, recipeContext } from '../../../cli/recipe.mjs';

const version = '7.0.2005';
const slotName = '@oxlint-tsgolint/openharmony-arm64';
const rootDir = import.meta.dirname;
const stageDir = join(rootDir, 'build');
const stageSourceDir = join(stageDir, 'src');
const sourceCheckout = join(stageDir, 'tsgolint-src');
const outputDir = join(rootDir, `oxlint-tsgolint-${version}`);
let beforeHashes = {};

function listFiles(root, dir = root) {
  const files = [];
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    const file = join(dir, entry.name);
    if (entry.isDirectory()) files.push(...listFiles(root, file));
    else if (entry.isFile()) files.push(relative(root, file).split(sep).join('/'));
  }
  return files.sort();
}

function hashDirectory(root) {
  return Object.fromEntries(listFiles(root).map((file) => [
    file,
    createHash('sha256').update(readFileSync(join(root, file))).digest('hex'),
  ]));
}

function filteredHashes(hashes, excluded) {
  return Object.entries(hashes).filter((entry) => !excluded.has(entry[0]));
}

export default class OxlintTsgolint extends Port {
  static pkgname = 'oxlint-tsgolint';
  static upstream = 'oxlint-tsgolint';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [`oxlint-tsgolint-${version}`];
  static source = `https://registry.npmjs.org/oxlint-tsgolint/-/oxlint-tsgolint-${version}.tgz`;
  static sha256 = 'b21f089ca487fcfeb0d7200ac2db85d76674e5d66eff97e469ff82b4c33a6990';
  prepare() {
    run('brew', ['install', '-y', 'go']);
    rmSync(stageDir, { recursive: true, force: true });
    mkdirSync(stageDir, { recursive: true });
    run('git', [
      'clone', '--depth', '1', '--branch', `v${version}`,
      'https://github.com/oxc-project/tsgolint.git', 'tsgolint-src',
    ], { cwd: stageDir });
    run('git', ['-C', 'tsgolint-src', 'config', 'user.email', 'port@example.com'], { cwd: stageDir });
    run('git', ['-C', 'tsgolint-src', 'config', 'user.name', 'port'], { cwd: stageDir });
    run('git', ['-C', 'tsgolint-src', 'submodule', 'update', '--init', '--depth', '1'], { cwd: stageDir });
    run('git', ['-C', 'tsgolint-src/typescript-go', 'config', 'user.email', 'port@example.com'], { cwd: stageDir });
    run('git', ['-C', 'tsgolint-src/typescript-go', 'config', 'user.name', 'port'], { cwd: stageDir });

    fetchSource(join(stageDir, 'src.tgz'));
    run('tar', ['-zxf', 'src.tgz'], { cwd: stageDir });
    rmSync(join(stageDir, 'src.tgz'));
    renameSync(join(stageDir, 'package'), stageSourceDir);
  }

  build() {
    cd(sourceCheckout);
    const patches = readdirSync('patches')
      .filter((file) => /^0.*\.patch$/.test(file))
      .sort()
      .map((file) => join('..', 'patches', file));
    assert.ok(patches.length > 0, 'typescript-go patches are missing');
    run('git', ['am', '--3way', '--no-gpg-sign', ...patches], { cwd: join(sourceCheckout, 'typescript-go') });

    const collections = join(sourceCheckout, 'internal/collections');
    mkdirSync(collections, { recursive: true });
    const upstreamCollections = join(sourceCheckout, 'typescript-go/internal/collections');
    for (const file of listFiles(upstreamCollections)) {
      if (!file.endsWith('_test.go')) cpSync(join(upstreamCollections, file), join(collections, basename(file)));
    }

    process.env.GOTMPDIR = join(sourceCheckout, '.gotmpdir');
    process.env.GOCACHE = join(sourceCheckout, '.gocache');
    process.env.GOMODCACHE = join(run('brew', ['--prefix'], { capture: true }).stdout.trim(), 'var/go-mod-cache');
    mkdirSync(process.env.GOTMPDIR, { recursive: true });
    mkdirSync(process.env.GOCACHE, { recursive: true });
    mkdirSync(process.env.GOMODCACHE, { recursive: true });
    run('go', ['build', '-ldflags=-s -w', '-trimpath', '-o', 'tsgolint', './cmd/tsgolint'], { cwd: sourceCheckout });
    chmodSync(join(sourceCheckout, 'tsgolint'), 0o755);
    beforeHashes = hashDirectory(stageSourceDir);
  }

  package() {
    cd(stageSourceDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0002-openharmony-loader.patch')) });
    assert.equal(readJson(join(stageSourceDir, 'package.json')).version, version);
    assert.ok(readFileSync(join(stageSourceDir, 'bin/tsgolint.js'), 'utf8').includes('openharmony'));
    run(process.execPath, ['--check', join(stageSourceDir, 'bin/tsgolint.js')]);

    rmSync(outputDir, { recursive: true, force: true });
    cpSync(stageSourceDir, outputDir, { recursive: true });
    const slotDir = join(outputDir, slotName);
    mkdirSync(slotDir, { recursive: true });
    cpSync(join(sourceCheckout, 'tsgolint'), join(slotDir, 'tsgolint'));
    chmodSync(join(slotDir, 'tsgolint'), 0o755);
    writeJson(join(slotDir, 'package.json'), {
      name: slotName,
      version,
      description: 'High-performance type-aware TypeScript linter powered by typescript-go, for use with oxlint. — OpenHarmony (OHOS) build',
      license: 'MIT',
      preferUnplugged: true,
      files: ['tsgolint'],
      os: ['openharmony'],
      cpu: ['arm64'],
    });

    rmSync(join(outputDir, 'package.json.orig'), { force: true });
    const afterHashes = hashDirectory(outputDir);
    const sourceExcluded = new Set(['package.json', 'bin/tsgolint.js']);
    const outputExcluded = new Set([
      ...sourceExcluded,
      `${slotName}/tsgolint`,
      `${slotName}/package.json`,
    ]);
    assert.deepEqual(filteredHashes(afterHashes, outputExcluded), filteredHashes(beforeHashes, sourceExcluded));

    rmSync(stageDir, { recursive: true, force: true });
    assert.ok(statSync(outputDir).isDirectory());
    console.log(`OK: @ohos-npm-ports/oxlint-tsgolint ${version} built; installed-entry smoke test is declared`);
  }

  static testPlatforms = ['openharmony'];
  static testPlatformReason = 'The smoke test executes the bundled OpenHarmony arm64 tsgolint binary.';

  test() {
    const { projectDir } = recipeContext();
    const entry = recipeContext().resolvePackage('oxlint-tsgolint/bin/tsgolint.js');
    const smokeDir = join(projectDir, 'smoke');
    mkdirSync(smokeDir, { recursive: true });
    writeFileSync(join(smokeDir, 'tsconfig.json'), '{"compilerOptions":{"strict":true}}');
    writeFileSync(join(smokeDir, 'bad.ts'), 'const n = 1 as unknown as string | undefined;\n');
    const result = run(process.execPath, [entry, '-tsconfig', 'tsconfig.json', 'bad.ts'], {
      cwd: smokeDir,
      capture: true,
      allowExitCodes: [0, 1],
    });
    const output = `${result.stdout}${result.stderr}`;
    assert.ok(output.includes('no-unsafe-type-assertion'), output);
    console.log(`OK: @ohos-npm-ports/oxlint-tsgolint ${version} installed entry smoke-tested`);
    return {
      result: { diagnostic: 'no-unsafe-type-assertion' },
      assets: [],
    };
  }
}
