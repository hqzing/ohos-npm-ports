#!/usr/bin/env node
import assert from 'node:assert/strict';
import { cpSync, existsSync, mkdirSync, readFileSync, readdirSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs';
import { join, relative, sep } from 'node:path';
import { Port, resource, run, cd, fetchSource, fetchResource, readJson, writeJson, recipeContext } from '../../../cli/recipe.mjs';

const version = '0.8.1';
const rootDir = import.meta.dirname;
const sourceDir = join(rootDir, `opentui-${version}`);
const packageDir = join(rootDir, `opentui-core-${version}`);
const distDir = join(sourceDir, 'packages/core/dist');
const ohosTriple = 'aarch64-linux-ohos';
const slotRootDir = join(rootDir, 'slots/openharmony-arm64');
const slotSourceDir = join(slotRootDir, `opentui-${version}`);
const slotPackageDir = join(slotRootDir, `opentui-core-openharmony-arm64-${version}`);
const slotNativeLib = join(slotSourceDir, `packages/native/lib/${ohosTriple}/libopentui.so`);

function listFiles(root, dir = root) {
  const files = [];
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    const file = join(dir, entry.name);
    if (entry.isDirectory()) files.push(...listFiles(root, file));
    else files.push(relative(root, file).split(sep).join('/'));
  }
  return files.sort();
}

function configureOhos(root, toolchains = false) {
  const installed = run('brew', ['list', '--versions', 'ohos-sdk-native'], {
    capture: true,
    allowExitCodes: [0, 1],
  });
  if (installed.code !== 0) run('brew', ['install', '-y', 'ohos-sdk-native']);
  if (toolchains) run('brew', ['install', 'ohos-sdk-toolchains']);
  run('brew', ['install', 'zig@0.17']);
  run('zig', ['version']);
  process.env.ZIG_GLOBAL_CACHE_DIR = join(root, 'zig-cache');

  const ohosSdk = run('brew', ['--prefix', 'ohos-sdk-native'], { capture: true }).stdout.trim();
  const ohosSysroot = join(ohosSdk, 'sysroot');
  let ohosClangRuntime = '';
  const clangRoot = join(ohosSdk, 'llvm/lib/clang');
  if (existsSync(clangRoot)) {
    for (const entry of readdirSync(clangRoot, { withFileTypes: true })) {
      const candidate = join(clangRoot, entry.name, 'lib', ohosTriple);
      if (entry.isDirectory() && existsSync(candidate) && statSync(candidate).isDirectory()) ohosClangRuntime = candidate;
    }
  }
  assert.ok(
    existsSync(join(ohosSysroot, 'usr/lib', ohosTriple)) && statSync(join(ohosSysroot, 'usr/lib', ohosTriple)).isDirectory(),
    `OHOS sysroot is missing ${ohosTriple} libraries`,
  );
  assert.ok(ohosClangRuntime, `OHOS Clang runtime is missing for ${ohosTriple}`);

  process.env.ZIG_LIBC = join(root, 'ohos-libc.txt');
  writeFileSync(process.env.ZIG_LIBC, [
    `include_dir=${join(ohosSysroot, 'usr/include')}`,
    `sys_include_dir=${join(ohosSysroot, 'usr/include', ohosTriple)}`,
    `crt_dir=${join(ohosSysroot, 'usr/lib', ohosTriple)}`,
    'msvc_lib_dir=',
    'kernel32_lib_dir=',
    'darwin_sdk_dir=',
    `cc_dir=${ohosClangRuntime}`,
    '',
  ].join('\n'));
}

function assertChunkMarker(pattern, marker) {
  const files = readdirSync(packageDir).filter((file) => file.startsWith(pattern) && file.endsWith('.js'));
  assert.ok(files.some((file) => readFileSync(join(packageDir, file), 'utf8').includes(marker)), `${pattern}*.js: ${marker}`);
}

function copySlotLicenses(source, destination) {
  const vendor = join(source, 'packages/native/src/vendor');
  for (const [file, target] of [
    ['wuffs/LICENSE', 'LICENSE-WUFFS'],
    ['stb/LICENSE', 'LICENSE-STB'],
    ['libwebp/COPYING', 'LICENSE-LIBWEBP'],
    ['libwebp/PATENTS', 'PATENTS-LIBWEBP'],
    ['libwebp/AUTHORS', 'AUTHORS-LIBWEBP'],
    ['lcms2/LICENSE', 'LICENSE-LCMS2'],
  ]) {
    cpSync(join(vendor, file), join(destination, target));
  }
  cpSync(join(source, 'packages/core/THIRD_PARTY_LICENSES/GHOSTTY'), join(destination, 'LICENSE-GHOSTTY'));
}

function writeSlotPackage() {
  writeFileSync(join(slotPackageDir, 'index.js'), 'import { fileURLToPath } from "node:url"\n\nexport default fileURLToPath(new URL("./libopentui.so", import.meta.url))\n');
  writeFileSync(join(slotPackageDir, 'index.bun.js'), 'const module = await import("./libopentui.so", { with: { type: "file" } })\n\nexport default module.default\n');
  writeFileSync(join(slotPackageDir, 'index.d.ts'), 'declare const path: string\nexport default path\n');
  writeJson(join(slotPackageDir, 'package.json'), {
    version,
    description: 'Prebuilt openharmony-arm64 binaries for @opentui/core',
    type: 'module',
    main: 'index.js',
    module: 'index.js',
    types: 'index.d.ts',
    license: 'MIT',
    author: 'OpenTUI Contributors',
    exports: {
      '.': {
        bun: './index.bun.js',
        import: './index.js',
        types: './index.d.ts',
      },
    },
    os: ['openharmony'],
    cpu: ['arm64'],
  });
  cpSync(slotNativeLib, join(slotPackageDir, 'libopentui.so'));
  cpSync(join(slotSourceDir, 'LICENSE'), join(slotPackageDir, 'LICENSE'));
  copySlotLicenses(slotSourceDir, slotPackageDir);
}

export default class OpentuiCore extends Port {
  static pkgname = 'opentui-core';
  static upstream = '@opentui/core';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [
    `@ohos-npm-ports/opentui-core-openharmony-arm64:slots/openharmony-arm64/opentui-core-openharmony-arm64-${version}`,
    `opentui-core-${version}`,
  ];
  static source = `https://registry.npmjs.org/@opentui/core/-/core-${version}.tgz`;
  static sha256 = '91f980e93c67ce71d0fac3f5ca773decee2c008174f04bd357b024246dad953a';
  static resources = [
    resource(
      'upstream',
      `https://codeload.github.com/anomalyco/opentui/tar.gz/refs/tags/v${version}`,
      '3418421c786f56c30a438c00b268d1b653d3efa826ff40fcffb72df7ae8bb765',
    ),
  ];
  prepare() {
    delete process.env.LD_PRELOAD;
    run('brew', ['install', 'bun']);
    run('bun', ['--version']);
    configureOhos(rootDir);

    fetchSource(join(rootDir, 'core.tgz'));
    run('tar', ['-zxf', 'core.tgz'], { cwd: rootDir });
    rmSync(join(rootDir, 'core.tgz'));
    renameSync(join(rootDir, 'package'), packageDir);

    fetchResource('upstream', join(rootDir, `opentui-${version}.tar.gz`));
    run('tar', ['-zxf', `opentui-${version}.tar.gz`], { cwd: rootDir });
    rmSync(join(rootDir, `opentui-${version}.tar.gz`));
  }

  build() {
    cd(sourceDir);
    for (const patch of [
      '0002-openharmony-core-src.patch',
      '0003-ohos-weak-pthread-tryjoin.patch',
      '0004-skip-native-abi-check.patch',
      '0005-ohos-zig-target.patch',
    ]) {
      run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches', patch)) });
    }
    assert.ok(readFileSync('packages/core/scripts/build.ts', 'utf8').includes('"#opentui/parser-worker"'));
    assert.ok(readFileSync('packages/core/src/platform/runtime-assets.bun.ts', 'utf8').includes('core-openharmony-arm64'));
    assert.ok(readFileSync('packages/core/src/platform/runtime-assets.node.ts', 'utf8').includes('core-openharmony-arm64'));
    assert.ok(readFileSync('packages/native/src/clipboard/host.zig', 'utf8').includes('linkage = .weak'));
    assert.ok(readFileSync('packages/native/build.zig', 'utf8').includes('"aarch64-linux-ohos"'));

    run('bun', ['install', '--ignore-scripts']);
    run('bun', ['scripts/build.ts', '--lib'], {
      cwd: join(sourceDir, 'packages/core'),
      env: { OPENTUI_SKIP_NATIVE_ABI_CHECK: '1' },
    });

    for (const file of readdirSync(packageDir)) {
      if (file.endsWith('.js') || file.endsWith('.js.map')) rmSync(join(packageDir, file), { force: true });
    }
    rmSync(join(packageDir, 'lib/tree-sitter/update-assets.js'), { force: true });
    rmSync(join(packageDir, 'lib/tree-sitter/update-assets.js.map'), { force: true });
    for (const file of readdirSync(distDir)) {
      if (file.endsWith('.js') || file.endsWith('.js.map')) cpSync(join(distDir, file), join(packageDir, file));
    }
    cpSync(join(distDir, 'lib/tree-sitter/update-assets.js'), join(packageDir, 'lib/tree-sitter/update-assets.js'));
    cpSync(join(distDir, 'lib/tree-sitter/update-assets.js.map'), join(packageDir, 'lib/tree-sitter/update-assets.js.map'));
  }

  package() {
    cd(packageDir);
    run('patch', ['-p1'], { input: readFileSync(join(rootDir, 'patches/0001-update-package-json.patch')) });
    assert.ok(!listFiles(packageDir).some((file) => file.endsWith('.so')), 'parent package must not ship native libraries');
    assert.ok(statSync(join(rootDir, 'ohos-libc.txt')).size > 0);

    const pkg = readJson(join(packageDir, 'package.json'));
    assert.equal(pkg.imports['#opentui/parser-worker'], './parser.worker.js');
    for (const file of listFiles(packageDir)) {
      if ((file.split('/').length === 1 || file.startsWith('lib/tree-sitter/')) && file.endsWith('.js')) {
        run(process.execPath, ['--check', join(packageDir, file)]);
      }
    }

    const optional = pkg.optionalDependencies ?? {};
    const slotAlias = `npm:@ohos-npm-ports/opentui-core-openharmony-arm64@${pkg.version}`;
    assert.equal(optional['@opentui/core-openharmony-arm64'], slotAlias, 'slot alias mismatch');
    for (const [name, range] of Object.entries(optional)) {
      if (name !== '@opentui/core-openharmony-arm64') assert.equal(range, version, name);
    }

    for (const marker of ['openharmony: "libopentui.so"', '"@opentui/core-openharmony-arm64"']) {
      assertChunkMarker('chunk-bun-', marker);
      assertChunkMarker('chunk-node-', marker);
    }
    assertChunkMarker('chunk-bun-', '#opentui/parser-worker');
    assert.ok(readFileSync(join(packageDir, 'node-assets.js'), 'utf8').includes('openharmony: "libopentui.so"'));

    const selfImport = /(from|import\(|require\()"@opentui\/core["/]/;
    for (const file of listFiles(packageDir)) {
      if (file.endsWith('.js')) assert.ok(!selfImport.test(readFileSync(join(packageDir, file), 'utf8')), `Bare @opentui/core self-import: ${file}`);
    }
  }

  slot_openharmony_arm64_prepare() {
    delete process.env.LD_PRELOAD;
    configureOhos(slotRootDir, true);
    fetchResource('upstream', join(slotRootDir, `opentui-${version}.tar.gz`));
    run('tar', ['-zxf', `opentui-${version}.tar.gz`], { cwd: slotRootDir });
    rmSync(join(slotRootDir, `opentui-${version}.tar.gz`));
  }

  slot_openharmony_arm64_build() {
    cd(slotSourceDir);
    for (const patch of ['0003-ohos-weak-pthread-tryjoin.patch', '0005-ohos-zig-target.patch']) {
      run('patch', ['-p1'], { input: readFileSync(join(slotRootDir, 'patches', patch)) });
    }
    assert.ok(readFileSync('packages/native/src/clipboard/host.zig', 'utf8').includes('linkage = .weak'));
    assert.ok(readFileSync('packages/native/build.zig', 'utf8').includes('"aarch64-linux-ohos"'));

    const nativeDir = join(slotSourceDir, 'packages/native');
    run('sh', ['scripts/prepare-zig-deps.sh'], { cwd: nativeDir });
    run('zig', ['build', `-Dlibrary-target=${ohosTriple}`, '-Doptimize=ReleaseFast'], { cwd: nativeDir });
    assert.ok(existsSync(slotNativeLib) && statSync(slotNativeLib).isFile(), `no libopentui.so under lib/${ohosTriple}`);
  }

  slot_openharmony_arm64_package() {
    const llvmStrip = join(run('brew', ['--prefix', 'llvm@22'], { capture: true }).stdout.trim(), 'bin/llvm-strip');
    run(llvmStrip, ['--strip-all', slotNativeLib]);
    mkdirSync(slotPackageDir, { recursive: true });
    writeSlotPackage();

    const pkg = readJson(join(slotPackageDir, 'package.json'));
    assert.deepEqual(pkg.os, ['openharmony']);
    assert.deepEqual(pkg.cpu, ['arm64']);
    run('python3', [
      '-c', "import ctypes, sys; ctypes.CDLL(sys.argv[1]); print('dlopen OK')", join(slotPackageDir, 'libopentui.so'),
    ]);
    console.log(`OK: @ohos-npm-ports/opentui-core-openharmony-arm64 ${version} packed with source-built core`);
  }

  static testPlatforms = ['openharmony'];
  static testPlatformReason = 'Requires the OpenHarmony native slot and Bun compile runtime.';

  testSetup() {
    run('brew', ['install', 'bun']);
    const { projectDir } = recipeContext();
    const file = join(projectDir, 'package.json');
    const pkg = readJson(file);
    pkg.dependencies ??= {};
    pkg.dependencies['web-tree-sitter'] = '0.25.10';
    writeJson(file, pkg);
  }

  test() {
    const { projectDir } = recipeContext();
    writeFileSync(join(projectDir, 'app.mjs'), `import { createTestRenderer } from "@opentui/core/testing"
import { BoxRenderable } from "@opentui/core"

const setup = await createTestRenderer({ width: 30, height: 10 })
const box = new BoxRenderable(setup.renderer, { width: 10, height: 3, border: true, title: "ohos" })
setup.renderer.root.add(box)
await setup.renderOnce()
const frame = setup.captureCharFrame()
if (!frame.includes("ohos")) throw new Error("frame missing box title")
console.log("SMOKE-OK bun-render")
await setup.renderer.destroy()
`);
    run('bun', ['app.mjs'], { cwd: projectDir });
    run('bun', ['build', '--compile', 'app.mjs', '--outfile', 'smoke-bin'], { cwd: projectDir });
    const isolatedDir = join(projectDir, 'isolated');
    mkdirSync(isolatedDir, { recursive: true });
    cpSync(join(projectDir, 'smoke-bin'), join(isolatedDir, 'smoke-bin'));
    run(join(isolatedDir, 'smoke-bin'), [], { cwd: isolatedDir });

    writeFileSync(join(projectDir, 'node-import.mjs'), 'import "@opentui/core";\nconsole.log("SMOKE-OK node-import");\n');
    run(process.execPath, ['node-import.mjs'], { cwd: projectDir });
    console.log(`OK: @ohos-npm-ports/opentui-core ${version} rebuilt from source (slot: openharmony-arm64)`);
    return {
      result: { bunRender: true, bunCompile: true, nodeImport: true },
      assets: [],
    };
  }
}
