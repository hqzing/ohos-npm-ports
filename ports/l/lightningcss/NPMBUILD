#!/usr/bin/env node
import assert from 'node:assert/strict';
import { Port, run, cd, fetchSource, readJson } from '../../../cli/recipe.mjs';
import { chmodSync, readFileSync, rmSync, statSync } from 'node:fs';

const version = '1.33.0';
const rootDir = import.meta.dirname;

export default class Lightningcss extends Port {
  static pkgname = 'lightningcss';
  static upstream = 'lightningcss';
  static version = version;
  static revision = 3;
  static distTag = 'latest';
  static packages = [`lightningcss-${version}`];
  static source = `https://github.com/parcel-bundler/lightningcss/archive/refs/tags/v${version}.tar.gz`;
  static sha256 = '3197aa5188b66d0d1e5026cbc8b65c4c0c53fdc949f9ed497fe75df2d13f722a';

  build() {
    cd(rootDir);
    fetchSource('lightningcss.tar.gz');
    run('tar', ['-zxf', 'lightningcss.tar.gz']);
    rmSync('lightningcss.tar.gz');

    cd(`lightningcss-${version}`);
    run('patch', ['-p1'], { input: readFileSync('../patches/0001-update-package-json.patch') });
    run('patch', ['-p1'], { input: readFileSync('../patches/0002-openharmony-loader.patch') });
    run('npm', ['install', '--ignore-scripts']);

    process.env.PATH = `${process.cwd()}/node_modules/.bin:${process.env.PATH}`;
    run('node', ['scripts/build.js', '--release']);

    const native = 'lightningcss.linux-arm64-ohos.node';
    assert.ok(statSync(native).isFile());
    run('llvm-strip', ['--strip-all', native]);
    chmodSync(native, statSync(native).mode | 0o111);

    run('node', ['--check', 'node/index.js']);
    assert.ok(readFileSync('node/index.js', 'utf8').includes("process.platform === 'openharmony'"));

    const pkg = readJson('package.json');
    const base = pkg.version;
    for (const [name, range] of Object.entries(pkg.optionalDependencies ?? {})) {
      if (name.startsWith('lightningcss-')) {
        assert.equal(range, base, `optionalDependencies["${name}"] = ${range}, expected ${base}`);
      }
    }

    run('node', ['-e', `
      const { transform } = require('./node/index.js');
      const { code } = transform({
        filename: 'test.css',
        code: Buffer.from('.a { color: red }'),
        minify: true,
      });
      const out = code.toString();
      console.log('transform() output:', out);
      if (!out.includes('.a') || !out.includes('red')) {
        throw new Error('unexpected transform output');
      }
    `]);
  }
}
