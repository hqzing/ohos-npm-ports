#!/usr/bin/env node
import assert from 'node:assert/strict';
import { Port, resource, run, cd, fetchSource, fetchResource, readJson } from '../../../cli/recipe.mjs';
import { chmodSync, cpSync, existsSync, readFileSync, renameSync, rmSync, statSync } from 'node:fs';
import { join } from 'node:path';

const version = '0.51.0';
const rootDir = import.meta.dirname;

export default class AstGrepNapi extends Port {
  static pkgname = 'ast-grep-napi';
  static upstream = '@ast-grep/napi';
  static version = version;
  static revision = 1;
  static distTag = 'latest';
  static packages = [`ast-grep-napi-${version}`];
  static source = `https://github.com/ast-grep/ast-grep/archive/refs/tags/${version}.tar.gz`;
  static sha256 = 'aade9c7059f1588d322dcedc058372325758211bfaa46f7170c097ee9da4b0c7';
  static resources = [
    resource(
      'npm',
      `https://registry.npmjs.org/@ast-grep/napi/-/napi-${version}.tgz`,
      '63d201c32fdd45b12dfbd6df396cef3348eb103ed892247897dbf64a67e03bbd',
    ),
  ];

  build() {
    cd(rootDir);
    fetchSource(`ast-grep-${version}.tar.gz`);
    run('tar', ['-zxf', `ast-grep-${version}.tar.gz`]);
    rmSync(`ast-grep-${version}.tar.gz`);

    cd(`ast-grep-${version}`);
    try {
      run('curl', ['-fsIL', '--max-time', '8', '-o', '/dev/null', 'https://index.crates.io/config.json'], { capture: true });
    } catch {
      process.env.CARGO_REGISTRIES_CRATES_IO_INDEX = 'sparse+https://rsproxy.cn/index/';
    }

    run('cargo', ['build', '-p', 'ast-grep-napi', '--release']);
    const nodeSource = join('target/release', 'libast_grep_napi.so');
    assert.ok(existsSync(nodeSource), 'no napi cdylib in target/release');
    cpSync(nodeSource, '../ast-grep-napi.node');
    cd('..');

    fetchResource('npm', `ast-grep-napi-${version}.tgz`);
    run('tar', ['-zxf', `ast-grep-napi-${version}.tgz`]);
    rmSync(`ast-grep-napi-${version}.tgz`);
    renameSync('package', `ast-grep-napi-${version}`);

    cd(`ast-grep-napi-${version}`);
    run('patch', ['-p1'], { input: readFileSync('../patches/0001-update-package-json.patch') });
    const pkg = readJson('package.json');
    assert.ok(pkg.files.includes('ast-grep-napi.openharmony-arm64.node'));
    assert.equal(pkg.optionalDependencies['@ast-grep/napi-linux-arm64-gnu'], version);
    assert.ok(!readFileSync('package.json', 'utf8').includes('"prepublishOnly"'), 'prepublishOnly still present');

    const native = 'ast-grep-napi.openharmony-arm64.node';
    cpSync('../ast-grep-napi.node', native);
    chmodSync(native, statSync(native).mode | 0o111);

    const loader = readFileSync('index.js', 'utf8');
    assert.ok(loader.includes("process.platform === 'openharmony'"));
    assert.ok(loader.includes('./ast-grep-napi.openharmony-arm64.node'));

    run('node', ['-e', `
      const { parse, Lang } = require('./index.js');
      const root = parse(Lang.JavaScript, 'const a = 1 + 2;').root();
      const m = root.find('$A + $B');
      if (!m || m.getMatch('A').text() !== '1' || m.getMatch('B').text() !== '2') throw new Error('napi smoke failed');
      console.log('loader + parse smoke OK');
    `]);
    console.log(`OK: @ohos-npm-ports/ast-grep-napi ${version}`);
  }
}
